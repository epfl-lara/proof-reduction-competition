  "proof": "theorem putnam_1995_a3\n(relation : (Fin 9 → ℤ) → (Fin 9 → ℤ) → Prop)\n(digits_to_num : (Fin 9 → ℤ) → ℤ)\n(hdigits_to_num : digits_to_num = fun dig => ∑ i : Fin 9, (dig i) * 10^i.1)\n(hrelation : ∀ d e : (Fin 9 → ℤ), relation d e ↔ (∀ i : Fin 9, d i < 10 ∧ d i ≥ 0 ∧ e i < 10 ∧ e i ≥ 0) ∧ (∀ i : Fin 9, 7 ∣ (digits_to_num (fun j : Fin 9 => if j = i then e j else d j))))\n: ∀ d e f : (Fin 9 → ℤ), ((relation d e) ∧ (relation e f)) → (∀ i : Fin 9, 7 ∣ d i - f i) := by\n  have step (a b : Fin 9 → ℤ) (hab : relation a b) (i : Fin 9) :\n      7 ∣ (b i - a i) * 10 ^ i.1 + digits_to_num a := by\n    convert ((hrelation a b).mp hab).2 i using 1\n    rw [hdigits_to_num]\n    calc\n      _ = ∑ j : Fin 9, ((if j = i then (b j - a j) * 10 ^ j.1 else 0) +\n          a j * 10 ^ j.1) := by\n        rw [Finset.sum_add_distrib]\n        simp only [Finset.sum_ite_eq', Finset.mem_univ, if_true]\n      _ = _ := by\n        apply Finset.sum_congr rfl\n        intro j _\n        by_cases hij : j = i <;> simp only [hij, ↓reduceIte] <;> ring\n  intro d e f h\n  have hd := step d e h.1\n  have he := step e f h.2\n  have hs : 7 ∣ digits_to_num e - digits_to_num d + 9 * digits_to_num d := by\n    have hs := Finset.dvd_sum (s := Finset.univ) (fun i _ => hd i)\n    simpa only [hdigits_to_num, sub_mul, Finset.sum_add_distrib,\n      Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ,\n      Fintype.card_fin, Int.nsmul_eq_mul, Nat.cast_ofNat] using hs\n  have hsum : 7 ∣ digits_to_num d + digits_to_num e := by\n    convert dvd_sub hs (dvd_mul_right (7 : ℤ) (digits_to_num d)) using 1 <;> ring\n  intro i\n  have hi : 7 ∣ (d i - f i) * (10 : ℤ) ^ i.1 := by\n    convert dvd_sub hsum (dvd_add (hd i) (he i)) using 1 <;> ring\n  have hp : Prime (7 : ℤ) := Int.prime_iff_natAbs_prime.mpr (by decide)\n  exact (hp.dvd_mul.mp hi).resolve_right\n    (fun h => (by decide : ¬ (7 : ℤ) ∣ 10) (hp.dvd_of_dvd_pow h))",
