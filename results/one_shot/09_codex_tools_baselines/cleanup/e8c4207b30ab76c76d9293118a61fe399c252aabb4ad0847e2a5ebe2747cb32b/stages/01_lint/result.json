  "proof": "theorem parallelReduction_diamond : Diamond ParallelReduction := by\n  intro a a₁ a₂ h₁ h₂\n  induction h₁ generalizing a₂\n  case refl => exact ⟨_, h₂, .refl _⟩\n  case red_I a =>\n    cases h₂\n    case refl => exact ⟨_, .refl _, .red_I _⟩\n    case red_I => exact ⟨_, .refl _, .refl _⟩\n    case par c a' hc ha =>\n      rw [I_irreducible _ hc]\n      exact ⟨_, ha, .red_I _⟩\n  case red_K a b =>\n    cases h₂\n    case refl => exact ⟨_, .refl _, .red_K _ _⟩\n    case red_K => exact ⟨_, .refl _, .refl _⟩\n    case par a' b' ha hb =>\n      obtain ⟨u, hu, rfl⟩ := Ka_irreducible _ _ ha\n      exact ⟨_, hu, .red_K _ _⟩\n  case red_S a b c =>\n    cases h₂\n    case refl => exact ⟨_, .refl _, .red_S _ _ _⟩\n    case red_S => exact ⟨_, .refl _, .refl _⟩\n    case par d c' hd hc =>\n      obtain ⟨u, v, hu, hv, rfl⟩ := Sab_irreducible _ _ _ hd\n      exact ⟨_, .par (.par hu hc) (.par hv hc), .red_S _ _ _⟩\n  case par a a' b b' ha hb iha ihb =>\n    cases h₂\n    case refl => exact ⟨_, .refl _, .par ha hb⟩\n    case red_I =>\n      rw [I_irreducible _ ha]\n      exact ⟨_, .red_I _, hb⟩\n    case red_K =>\n      obtain ⟨u, hu, rfl⟩ := Ka_irreducible _ _ ha\n      exact ⟨_, .red_K _ _, hu⟩\n    case red_S =>\n      obtain ⟨u, v, hu, hv, rfl⟩ := Sab_irreducible _ _ _ ha\n      exact ⟨_, .red_S _ _ _, .par (.par hu hb) (.par hv hb)⟩\n    case par a'' b'' ha'' hb'' =>\n      obtain ⟨u, hu, hu'⟩ := iha ha''\n      obtain ⟨v, hv, hv'⟩ := ihb hb''\n      exact ⟨_, .par hu hv, .par hu' hv'⟩",
