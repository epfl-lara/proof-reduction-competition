  "proof": "theorem bisimilarity_congr_choice :\n    (p ~[lts (defs := defs)] q) → (choice p r) ~[lts (defs := defs)] (choice q r) := by\n  intro h\n  refine ⟨@ChoiceBisim _ _ defs, .choice h, ?_⟩\n  intro s1 s2 hr μ\n  cases hr with\n  | choice hb =>\n    constructor\n    · intro s' ht\n      cases ht with\n      | choiceL ht =>\n        obtain ⟨q', hq, h'⟩ := hb.follow_fst ht\n        exact ⟨q', Tr.choiceL hq, .bisim h'⟩\n      | choiceR ht =>\n        exact ⟨_, Tr.choiceR ht, .bisim (HomBisimilarity.refl _)⟩\n    · intro s' ht\n      cases ht with\n      | choiceL ht =>\n        obtain ⟨p', hp, h'⟩ := hb.follow_snd ht\n        exact ⟨p', Tr.choiceL hp, .bisim h'⟩\n      | choiceR ht =>\n        exact ⟨_, Tr.choiceR ht, .bisim (HomBisimilarity.refl _)⟩\n  | bisim hb =>\n    constructor\n    · intro s' ht\n      obtain ⟨q', hq, h'⟩ := hb.follow_fst ht\n      exact ⟨q', hq, .bisim h'⟩\n    · intro s' ht\n      obtain ⟨p', hp, h'⟩ := hb.follow_snd ht\n      exact ⟨p', hp, .bisim h'⟩",
