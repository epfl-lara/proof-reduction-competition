  "final_proof": "theorem putnam_1995_a3\n(relation : (Fin 9 → ℤ) → (Fin 9 → ℤ) → Prop)\n(digits_to_num : (Fin 9 → ℤ) → ℤ)\n(hdigits_to_num : digits_to_num = fun dig => ∑ i : Fin 9, (dig i) * 10^i.1)\n(hrelation : ∀ d e : (Fin 9 → ℤ), relation d e ↔ (∀ i : Fin 9, d i < 10 ∧ d i ≥ 0 ∧ e i < 10 ∧ e i ≥ 0) ∧ (∀ i : Fin 9, 7 ∣ (digits_to_num (fun j : Fin 9 => if j = i then e j else d j))))\n: ∀ d e f : (Fin 9 → ℤ), ((relation d e) ∧ (relation e f)) → (∀ i : Fin 9, 7 ∣ d i - f i) := by\n  have hs (a b : Fin 9 → ℤ) (i : Fin 9) :\n      digits_to_num (fun j => if j = i then b j else a j) =\n        digits_to_num a + (b i - a i) * 10 ^ i.1 := by\n    simp only [hdigits_to_num]\n    calc\n      _ = ∑ j : Fin 9, (a j * 10 ^ j.1 +\n          if j = i then (b j - a j) * 10 ^ j.1 else 0) := by\n        apply Finset.sum_congr rfl\n        intro j _\n        split_ifs <;> ring\n      _ = _ := by simp [Finset.sum_add_distrib]\n  intro d e f ⟨hde, hef⟩\n  have hd := ((hrelation d e).mp hde).2\n  have he := ((hrelation e f).mp hef).2\n  simp only [hs] at hd he\n  have hsum : 7 ∣ digits_to_num e + digits_to_num d := by\n    have ht := Finset.dvd_sum (s := Finset.univ) (fun i _ => hd i)\n    have hdiff : (∑ i : Fin 9, (e i - d i) * 10 ^ i.1) =\n        digits_to_num e - digits_to_num d := by\n      simp only [hdigits_to_num, sub_mul, Finset.sum_sub_distrib]\n    simp only [Finset.sum_add_distrib, hdiff, Finset.sum_const,\n      Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at ht\n    omega\n  intro i\n  have hc : IsCoprime (7 : ℤ) 10 := ⟨3, -2, by decide⟩\n  apply (hc.pow_right (n := i.1)).dvd_of_dvd_mul_right\n  convert dvd_sub hsum (dvd_add (hd i) (he i)) using 1 <;> ring",
