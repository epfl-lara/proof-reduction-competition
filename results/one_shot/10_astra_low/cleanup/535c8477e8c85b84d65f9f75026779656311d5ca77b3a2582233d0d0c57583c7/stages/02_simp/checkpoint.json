  "proof": "theorem bisimilarity_congr_choice :\n    (p ~[lts (defs := defs)] q) → (choice p r) ~[lts (defs := defs)] (choice q r) := by\n  intro h\n  refine ⟨@ChoiceBisim _ _ defs, ChoiceBisim.choice h, ?_⟩\n  intro s1 s2 hr μ\n  cases hr with\n  | choice hb =>\n    constructor\n    · intro s' ht\n      cases ht with\n      | choiceL ht =>\n        obtain ⟨t, ht, hb⟩ := hb.follow_fst ht\n        exact ⟨t, Tr.choiceL ht, ChoiceBisim.bisim hb⟩\n      | choiceR ht =>\n        exact ⟨s', Tr.choiceR ht, ChoiceBisim.bisim (HomBisimilarity.refl _)⟩\n    · intro s' ht\n      cases ht with\n      | choiceL ht =>\n        obtain ⟨t, ht, hb⟩ := hb.follow_snd ht\n        exact ⟨t, Tr.choiceL ht, ChoiceBisim.bisim hb⟩\n      | choiceR ht =>\n        exact ⟨s', Tr.choiceR ht, ChoiceBisim.bisim (HomBisimilarity.refl _)⟩\n  | bisim hb =>\n    constructor\n    · intro s' ht\n      obtain ⟨t, ht, hb⟩ := hb.follow_fst ht\n      exact ⟨t, ht, ChoiceBisim.bisim hb⟩\n    · intro s' ht\n      obtain ⟨t, ht, hb⟩ := hb.follow_snd ht\n      exact ⟨t, ht, ChoiceBisim.bisim hb⟩",
