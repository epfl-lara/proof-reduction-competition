pply Finset.card_bij' (fun A _ => Aᶜ) (fun A _ => Aᶜ)\n    · intro A hA\n      simp only [Set.mem_diff, Set.mem_univ, true_and] at hA ⊢\n      cases h_subset_or_compl A with\n      | inl h => exact (h_not_both A h hA).elim\n      | inr h => exact h\n    · intro A hA\n      simp only [Set.mem_diff, Set.mem_univ, true_and] at hA ⊢\n      cases h_subset_or_compl A with\n      | inl h => exact h\n      | inr h => exact (h_not_both A hA h).elim\n    · intro A; simp [Set.compl_compl]\n    · intro A; simp [Set.compl_compl]\n  \n  have h₂ : P.card + Q.card = 2 ^ Fintype.card S := by\n    rw [← Finset.card_sdiff (Finset.subset_univ P), Finset.card_univ, Fintype.card_set]\n  \n  have : 0 < Fintype.card S := Fintype.card_pos_iff.mpr ⟨default⟩\n  have h₃ : 2 ^ (Fintype.card S - 1) * 2 = 2 ^ Fintype.card S := by\n    rw [← pow_succ, Nat.sub_add_cancel this.le]\n  \n  rw [← h₃]\n  apply Nat.eq_of_mul_eq_mul_right (by norm_num : 0 < 2)\n  rw [← h₂, h₁]\n  ring\n```",
