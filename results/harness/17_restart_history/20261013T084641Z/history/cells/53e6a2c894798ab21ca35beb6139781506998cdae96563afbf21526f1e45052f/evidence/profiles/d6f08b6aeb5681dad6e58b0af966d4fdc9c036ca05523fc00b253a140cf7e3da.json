{
  "at": "2026-10-13T11:46:35.969782+00:00",
  "code": "theorem putnam_1964_a4\n(u : ℕ → ℤ)\n(boundedu : ∃ B T : ℤ, ∀ n : ℕ, B ≤ u n ∧ u n ≤ T)\n(hu : ∀ n ≥ 4, u n = ((u (n - 1) + u (n - 2) + u (n - 3) * u (n - 4)) : ℝ) / (u (n - 1) * u (n - 2) + u (n - 3) + u (n - 4)) ∧ (u (n - 1) * u (n - 2) + u (n - 3) + u (n - 4)) ≠ 0)\n: (∃ N c : ℕ, c > 0 ∧ ∀ n ≥ N, u (n + c) = u n)    := by\n  have hr n := (hu (n + 4) (Nat.le_add_left _ _)).1\n  simp [Nat.add_sub_assoc] at hr\n  obtain ⟨B, T, hB⟩ := boundedu\n  let v n : Set.Icc B T := ⟨u n, hB n⟩\n  let f n := (v n, v (n + 1), v (n + 2), v (n + 3))\n  obtain ⟨i, j, hij, h⟩ := Finite.wellQuasiOrdered Eq f\n  let c := j - i\n  have he : ∀ n ≥ i, f (n + c) = f n := by\n    apply Nat.le_induction\n    · simpa only [c, Nat.add_sub_of_le hij.le] using h.symm\n    · intro n hn ih\n      rw [Nat.add_right_comm]\n      simp [f, v] at ih ⊢\n      simp [ih]\n      apply Int.cast_injective (α := ℝ)\n      simp only [hr, ih]\n  exact ⟨i, c, Nat.sub_pos_of_lt hij, fun n hn => congr($(he n hn).1.val)⟩\n",
