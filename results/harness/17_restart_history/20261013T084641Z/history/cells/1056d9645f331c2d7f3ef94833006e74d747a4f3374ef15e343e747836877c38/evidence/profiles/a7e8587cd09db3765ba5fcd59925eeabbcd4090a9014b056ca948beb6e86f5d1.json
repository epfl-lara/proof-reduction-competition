  "code": "theorem parallelReduction_diamond : Diamond ParallelReduction := by\n  intro a a₁ a₂ h₁ h₂\n  induction h₁ generalizing a₂\n  case refl => exact ⟨_, h₂, .refl _⟩\n  all_goals cases h₂\n  case' red_I.par | red_K.par | red_S.par => refine _root_.symm ?_\n  case red_I.par | par.red_I =>\n    obtain rfl := I_irreducible _ ‹_›\n    exact ⟨_, .red_I _, ‹_›⟩\n  case red_K.par | par.red_K =>\n    obtain ⟨x, hx, rfl⟩ := Ka_irreducible _ _ ‹_›\n    exact ⟨_, .red_K .., hx⟩\n  case red_S.par | par.red_S =>\n    obtain ⟨x, y, hx, hy, rfl⟩ := Sab_irreducible _ _ _ ‹_›\n    exact ⟨_, .red_S .., by apply ParallelReduction.par <;> exact .par ‹_› ‹_›⟩\n  case par.par iha ihb e f ha' hb' =>\n    obtain ⟨x, hx⟩ := iha ha'\n    obtain ⟨y, hy⟩ := ihb hb'\n    exact ⟨_, .par hx.1 hy.1, .par hx.2 hy.2⟩\n  repeat' constructor\n  all_goals assumption\n",
