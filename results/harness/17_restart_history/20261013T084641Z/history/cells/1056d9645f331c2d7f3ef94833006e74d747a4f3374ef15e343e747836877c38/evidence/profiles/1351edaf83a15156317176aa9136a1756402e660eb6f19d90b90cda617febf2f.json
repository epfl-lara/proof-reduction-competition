  "code": "theorem parallelReduction_diamond : Diamond ParallelReduction := by\n  intro a a₁ a₂ h₁ h₂\n  induction h₁ generalizing a₂\n  case refl => exact ⟨_, h₂, .refl _⟩\n  all_goals cases h₂\n  case red_I.refl | red_K.refl | red_S.refl | par.refl =>\n    refine ⟨_, .refl _, ?_⟩\n    constructor <;> assumption\n  case red_I.red_I | red_K.red_K | red_S.red_S =>\n    exact ⟨_, .refl _, .refl _⟩\n  case' par.red_I | par.red_K | par.red_S => refine _root_.symm ?_\n  case red_I.par | par.red_I =>\n    cases ‹I ⭢ₚ _›\n    exact ⟨_, ‹_›, .red_I _⟩\n  case red_K.par | par.red_K =>\n    obtain ⟨x, hx, rfl⟩ := Ka_irreducible _ _ ‹_›\n    exact ⟨_, hx, .red_K ..⟩\n  case red_S.par | par.red_S =>\n    obtain ⟨x, y, hx, hy, rfl⟩ := Sab_irreducible _ _ _ ‹_›\n    exact ⟨_, .par (.par hx ‹_›) (.par hy ‹_›), .red_S ..⟩\n  case par.par =>\n    rename_i iha ihb e f ha' hb'\n    obtain ⟨x, hx, hx'⟩ := iha ha'\n    obtain ⟨y, hy, hy'⟩ := ihb hb'\n    exact ⟨x ⬝ y, .par hx hy, .par hx' hy'⟩\n",
