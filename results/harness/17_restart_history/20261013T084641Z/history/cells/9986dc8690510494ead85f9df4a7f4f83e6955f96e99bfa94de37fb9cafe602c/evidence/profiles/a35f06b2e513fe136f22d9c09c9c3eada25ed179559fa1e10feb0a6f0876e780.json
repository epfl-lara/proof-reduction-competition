  "code": "lemma Typing.progress (der : Typing [] t τ) : t.Value ∨ ∃ t', t ⭢βᵛ t' := by\n  generalize eq : [] = Γ at der\n  have lc := der.wf.2.1\n  induction der <;> subst eq\n  case var => simp_all\n  case abs | tabs => grind only [Value]\n  case app l r ih_l ih_r =>\n    right\n    rcases ih_l rfl l.wf.2.1 with vl | ⟨_, hl⟩\n    · obtain ⟨_, _, rfl⟩ := l.canonical_form_abs vl\n      specialize ih_r rfl r.wf.2.1\n      grind only [→ Value.lc, → Red.abs, → Red.appᵣ]\n    · exact ⟨_, .appₗ r.wf.2.1 hl⟩\n  case tapp der _ ih =>\n    cases lc with | tapp lc₁ lc₂ =>\n      specialize ih rfl lc₁\n      grind only [→ canonical_form_tabs, → Red.tabs, → Red.tapp]\n  case let' _ _ ih _ =>\n    obtain ⟨lc₁, body⟩ := body_let.mp lc\n    specialize ih rfl lc₁\n    grind only [→ Red.let_body, → Red.let_bind]\n  case inl der _ ih | inr der _ ih =>\n    specialize ih rfl der.wf.2.1\n    grind only [Value, → Red.inl, → Red.inr]\n  case case der _ _ ih _ _ =>\n    right\n    obtain ⟨lc₁, body₂, body₃⟩ := body_case.mp lc\n    rcases ih rfl lc₁ with val | ⟨_, red⟩\n    · obtain ⟨_, rfl | rfl⟩ := der.canonical_form_sum val <;> cases val <;>\n        grind only [→ Red.case_inl, → Red.case_inr]\n    · exact ⟨_, .case red body₂ body₃⟩\n  case sub _ _ ih => exact ih rfl lc\n",
