  "proof": "theorem fiberwise_dist_lt_imp_dist_lt_unique_decoding_radius (i : Fin ℓ) (steps : ℕ)\n    [NeZero steps] (h_i_add_steps : i.val + steps ≤ ℓ)\n    (f : OracleFunction 𝔽q β (h_ℓ_add_R_rate := h_ℓ_add_R_rate) ⟨i, by omega⟩)\n  (h_fw_dist_lt : fiberwiseClose 𝔽q β (h_ℓ_add_R_rate := h_ℓ_add_R_rate)\n    (i := i) (steps := steps) (h_i_add_steps := h_i_add_steps) (f := f)) :\n  hammingClose 𝔽q β (h_ℓ_add_R_rate := h_ℓ_add_R_rate) ⟨i, by omega⟩ f := by\n  let C := BBF_Code 𝔽q β (h_ℓ_add_R_rate := h_ℓ_add_R_rate) ⟨i, fin_ℓ_lt_ℓ_add_one i⟩\n  let Y (g : C) := fiberwiseDisagreementSet 𝔽q β i steps h_i_add_steps f g.val\n  let S := (fun g => (Y g).ncard) '' Set.univ\n  obtain ⟨g, _, hg⟩ := Nat.sInf_mem (Set.image_nonempty.mpr Set.univ_nonempty : S.Nonempty)\n  change (Y g).ncard = fiberwiseDistance 𝔽q β i steps h_i_add_steps f at hg\n  let q := iteratedQuotientMap 𝔽q β h_ℓ_add_R_rate i steps h_i_add_steps\n  let k := pointToIterateQuotientIndex 𝔽q β (h_ℓ_add_R_rate := h_ℓ_add_R_rate)\n    ⟨i, fin_ℓ_lt_ℓ_add_one i⟩ steps h_i_add_steps\n  have hr x :=\n    (is_fiber_iff_generates_quotient_point 𝔽q β i steps h_i_add_steps x (q x)).mp rfl\n  have hd := Set.ncard_le_ncard_of_injOn (fun x => (q x, k x))\n    (s := {x | f x ≠ g.val x}) (t := Y g ×ˢ (Set.univ : Set (Fin (2 ^ steps))))\n    (fun x hx => ⟨⟨x, rfl, hx⟩, Set.mem_univ _⟩)\n    (by\n      intro x hx z hz h\n      obtain ⟨hq, hk⟩ := Prod.mk.inj h\n      exact (hr x).symm.trans ((congrArg₂ _ hq hk).trans (hr z)))\n  simp only [Set.ncard_prod, Set.ncard_univ, Nat.card_fin,\n    ←Finset.coe_filter_univ, Set.ncard_coe_finset] at hd\n  have hb := Nat.mul_le_mul_right (2 ^ steps)\n    (Nat.le_of_lt_succ (WithTop.coe_lt_coe.1 h_fw_dist_lt))\n  simp only [←hg, mul_assoc, Nat.sub_mul,\n    ←Nat.sub_sub,\n    pow_sub_mul_pow 2 (Nat.le_sub_of_add_le' (h_i_add_steps.trans (Nat.le_add_right ℓ 𝓡))),\n    pow_sub_mul_pow 2 (Nat.le_sub_of_add_le' h_i_add_steps)] at hb\n  have hn := Nat.lt_succ_of_le ((Nat.mul_le_mul_left 2 hd).trans hb)\n  exact (mul_le_mul_left' (Code.distFromCode_le_dist_to_mem f g.val g.property) 2).trans_lt\n    (ENat.coe_lt_coe.2 hn)",
