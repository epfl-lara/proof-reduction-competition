  "proof": "lemma Typing.progress (der : Typing [] t τ) : t.Value ∨ ∃ t', t ⭢βᵛ t' := by\n  generalize eq : [] = Γ at der\n  have lc := der.wf.2.1\n  induction der <;> subst eq\n  case app | tapp =>\n    cases lc <;>\n      grind (gen := 2) only [→ canonical_form_abs, → canonical_form_tabs,\n        → Red.abs, → Red.tabs, → Red.appₗ, → Red.appᵣ, → Red.tapp]\n  case let' | case =>\n    grind (gen := 2) only [body_let, body_case, → canonical_form_sum,\n      → Red.let_body, → Red.let_bind, → Red.case_inl, → Red.case_inr, → Red.case]\n  all_goals grind only [Value, → wf, → Red.inl, → Red.inr, = Option.mem_def, = dlookup_nil]",
