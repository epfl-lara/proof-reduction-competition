  "proof": "theorem InitsUpdatesComm\n  {P : PureExpr} {σ σ' σ'' : SemanticStore P}\n  {ks ks' : List P.Ident} {vs vs' : List P.Expr} :\n  UpdateStates σ ks vs σ' →\n  InitStates σ' ks' vs' σ'' →\n  ∃ σ₁,\n    σ₁ = (updatedStates σ ks' vs') ∧\n    InitStates σ ks' vs' σ₁ ∧\n    UpdateStates σ₁ ks vs σ'' := by\n  intro hu hi\n  apply exists_eq_left.2\n  constructor\n  apply updatedStatesInit\n  exact InitStatesLength hi\n  exact UpdateStatesNotDefMonotone' (InitStatesNotDefined hi) hu\n  exact InitStatesNodup hi\n  cases UpdateStatesUpdated hu ▸ InitStatesUpdated hi\n  unfold updatedStates\n  rewrite [updatedStatesComm]\n  apply updatedStatesUpdate\n  exact UpdateStatesLength hu\n  apply updatedStatesDefMonotone\n  exact UpdateStatesDefined' hu\n  simp [List.unzip_zip, UpdateStatesLength hu, InitStatesLength hi]\n  intro k hk hk'\n  cases InitStatesNotDefined hi k hk' ▸ UpdateStatesDefined hu k hk",
