  "best_proof": "theorem InitsUpdatesComm\n  {P : PureExpr} {σ σ' σ'' : SemanticStore P}\n  {ks ks' : List P.Ident} {vs vs' : List P.Expr} :\n  UpdateStates σ ks vs σ' →\n  InitStates σ' ks' vs' σ'' →\n  ∃ σ₁,\n    σ₁ = (updatedStates σ ks' vs') ∧\n    InitStates σ ks' vs' σ₁ ∧\n    UpdateStates σ₁ ks vs σ'' := by\n  intro Hup Hinit\n  have HL := UpdateStatesLength Hup\n  have HL' := InitStatesLength Hinit\n  have Hnd := UpdateStatesNotDefMonotone' (InitStatesNotDefined Hinit) Hup\n  refine ⟨_, rfl, updatedStatesInit HL' Hnd (InitStatesNodup Hinit), (show σ'' = updatedStates _ ks vs from by\n    simp only [InitStatesUpdated Hinit, UpdateStatesUpdated Hup]\n    apply updatedStatesComm\n    simp [List.unzip_zip, *]\n    rintro _ hx hx'\n    simpa [Hnd _ hx'] using UpdateStatesDefined' Hup _ hx) ▸ updatedStatesUpdate HL (updatedStatesDefMonotone (UpdateStatesDefined' Hup))⟩\n",
