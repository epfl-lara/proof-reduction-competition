  "code": "theorem bisimilarity_congr_choice :\n    (p ~[lts (defs := defs)] q) → (choice p r) ~[lts (defs := defs)] (choice q r) := by\n  intro h\n  rw [HomBisimilarity.symm_simulation]\n  refine ⟨@ChoiceBisim _ _ _, .choice h, ?_, ?_⟩\n  · constructor; rintro x y (hc|hb)\n    · exact .choice hc.symm\n    · exact .bisim hb.symm\n  · rintro x y (hc|hb) μ z hz\n    · cases hz with\n      | choiceL hp => exact (hc.follow_fst hp).imp fun _ t => ⟨Tr.choiceL t.1, .bisim t.2⟩\n      | choiceR hs => exact ⟨_, Tr.choiceR hs, .bisim (HomBisimilarity.refl _)⟩\n    · exact (hb.follow_fst hz).imp fun _ t => ⟨t.1, .bisim t.2⟩\n",
