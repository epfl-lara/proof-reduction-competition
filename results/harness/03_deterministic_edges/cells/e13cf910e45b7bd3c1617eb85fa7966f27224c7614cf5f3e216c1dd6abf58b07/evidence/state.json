  "best_proof": "open OldExpressions in\ntheorem extractedOldExprInVars :\n  NormalizedOldExpr post →\n  (extractOldExprVars post).Subset\n  (Imperative.HasVarsPure.getVars post) := by\n  have cat {a b c d : List CoreIdent} (h : a.Subset c)\n      (k : b.Subset d) :=\n    List.Subset.app (fun x hx => List.mem_append_left _ (h hx))\n      (fun x hx => List.mem_append_right _ (k hx))\n  intro h\n  induction h with\n  | const | op | bvar | fvar => simp only [extractOldExprVars, List.Subset.empty]\n  | abs _ ih => assumption\n  | quant _ _ ih₁ ih₂ => exact cat ih₁ ih₂\n  | app _ _ hn ihfn ihe =>\n    unfold extractOldExprVars\n    split\n    · exact fun ⦃a⦄ a_1 => a_1\n    · next Hfalse =>\n        exfalso\n        cases hn .oldPred\n        apply Hfalse\n        rfl\n    · exact cat ihfn ihe\n  | ite _ _ _ ih₁ ih₂ ih₃ => exact cat (cat ih₁ ih₂) ih₃\n  | eq _ _ ih₁ ih₂ => exact cat ih₁ ih₂",
