  "best_proof": "theorem InitsUpdatesComm\n  {P : PureExpr} {σ σ' σ'' : SemanticStore P}\n  {ks ks' : List P.Ident} {vs vs' : List P.Expr} :\n  UpdateStates σ ks vs σ' →\n  InitStates σ' ks' vs' σ'' →\n  ∃ σ₁,\n    σ₁ = (updatedStates σ ks' vs') ∧\n    InitStates σ ks' vs' σ₁ ∧\n    UpdateStates σ₁ ks vs σ'' := by\n  intro Hup Hinit\n  refine ⟨updatedStates σ ks' vs', rfl, ?_, ?_⟩\n  · exact updatedStatesInit (InitStatesLength Hinit)\n      (UpdateStatesNotDefMonotone' (InitStatesNotDefined Hinit) Hup)\n      (InitStatesNodup Hinit)\n  · have hlenU := UpdateStatesLength Hup\n    have hcomm := updatedStatesComm (σ:=σ) (kvs:=ks'.zip vs') (kvs':=ks.zip vs) (by\n      rw [List.unzip_zip, List.unzip_zip]\n      · intro k hk hk'\n        simpa [InitStatesNotDefined Hinit k hk] using\n          (UpdateStatesDefined Hup k hk')\n      · exact hlenU\n      · exact InitStatesLength Hinit)\n    have hdef : isDefined (updatedStates σ ks' vs') ks :=\n      updatedStatesDefMonotone (UpdateStatesDefined' Hup)\n    simpa only [updatedStates, InitStatesUpdated Hinit, UpdateStatesUpdated Hup, hcomm] using\n      (updatedStatesUpdate hlenU hdef)\n",
