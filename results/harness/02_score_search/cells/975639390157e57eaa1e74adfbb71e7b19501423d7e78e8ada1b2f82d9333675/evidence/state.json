  "best_proof": "theorem putnam_1995_a3\n(relation : (Fin 9 → ℤ) → (Fin 9 → ℤ) → Prop)\n(digits_to_num : (Fin 9 → ℤ) → ℤ)\n(hdigits_to_num : digits_to_num = fun dig => ∑ i : Fin 9, (dig i) * 10^i.1)\n(hrelation : ∀ d e : (Fin 9 → ℤ), relation d e ↔ (∀ i : Fin 9, d i < 10 ∧ d i ≥ 0 ∧ e i < 10 ∧ e i ≥ 0) ∧ (∀ i : Fin 9, 7 ∣ (digits_to_num (fun j : Fin 9 => if j = i then e j else d j))))\n: ∀ d e f : (Fin 9 → ℤ), ((relation d e) ∧ (relation e f)) → (∀ i : Fin 9, 7 ∣ d i - f i) := by\n  let w : Fin 9 → ℤ := fun j => (10 : ℤ) ^ j.1\n  have patch (x y : Fin 9 → ℤ) (i : Fin 9) :\n      digits_to_num (fun j => if j = i then y j else x j) =\n        digits_to_num x + (y i - x i) * w i := by\n    rw [hdigits_to_num]\n    calc\n      (∑ j : Fin 9, (if j = i then y j else x j) * w j) =\n          ∑ j : Fin 9, (x j * w j + (if j = i then (y j - x j) else 0) * w j) := by\n        apply Finset.sum_congr rfl\n        intro j hj\n        by_cases h : j = i\n        · subst j\n          simp only [w, if_true]\n          ring\n        · simp only [w, if_neg h, zero_mul, add_zero]\n      _ = (∑ j : Fin 9, x j * w j) + (y i - x i) * w i := by\n        rw [Finset.sum_add_distrib]\n        simp [w, Finset.sum_ite_eq', Finset.mem_univ, i.is_lt]\n  intro d e f h i\n  have hd : ∀ j : Fin 9, 7 ∣ (digits_to_num (fun k : Fin 9 => if k = j then e k else d k)) :=\n    (hrelation d e).mp h.1 |>.2\n  have he : ∀ j : Fin 9, 7 ∣ (digits_to_num (fun k : Fin 9 => if k = j then f k else e k)) :=\n    (hrelation e f).mp h.2 |>.2\n  have ha : ∀ j : Fin 9, 7 ∣ (e j - d j) * w j + digits_to_num d := by\n    intro j\n    have := hd j\n    rw [patch d e j] at this\n    simpa [add_comm] using this\n  have hb : ∀ j : Fin 9, 7 ∣ (f j - e j) * w j + digits_to_num e := by\n    intro j\n    have := he j\n    rw [patch e f j] at this\n    simpa [add_comm] using this\n  have hdiff : digits_to_num e = digits_to_num d +\n      ∑ j : Fin 9, (e j - d j) * w j := by\n    rw [hdigits_to_num]\n    rw [← Finset.sum_add_distrib]\n    apply Finset.sum_congr rfl\n    intro j hj\n    ring\n  have hsum : 7 ∣ digits_to_num e + digits_to_num d := by\n    have hs : 7 ∣ (∑ j : Fin 9, (e j - d j) * w j) + 9 * digits_to_num d := by\n      have heq : (∑ j : Fin 9, ((e j - d j) * w j + digits_to_num d)) =\n          (∑ j : Fin 9, (e j - d j) * w j) + 9 * digits_to_num d := by\n        rw [Finset.sum_add_distrib]\n        simp [Finset.sum_const, Finset.card_fin]\n      rw [← heq]\n      apply Finset.dvd_sum\n      intro j hj\n      exact ha j\n    have h7 : 7 ∣ 7 * digits_to_num d := ⟨digits_to_num d, by ring⟩\n    have heq : digits_to_num e + digits_to_num d =\n        ((∑ j : Fin 9, (e j - d j) * w j) + 9 * digits_to_num d) - 7 * digits_to_num d := by\n      rw [hdiff]\n      ring\n    rw [heq]\n    exact dvd_sub hs h7\n  have hprod : 7 ∣ (d i - f i) * w i := by\n    have hh := dvd_add (dvd_sub (hb i) hsum) (ha i)\n    have hn := dvd_neg.mpr hh\n    convert hn using 1 <;> ring\n  have hp : Nat.Prime 7 := by norm_num\n  have hpow : ¬ (7 : ℤ) ∣ (10 : ℤ) ^ i.1 := by\n    intro q\n    have : (7 : ℤ) ∣ 10 := Int.Prime.dvd_pow' hp q\n    norm_num at this\n  exact (Int.Prime.dvd_mul' hp hprod).resolve_right hpow\n",
