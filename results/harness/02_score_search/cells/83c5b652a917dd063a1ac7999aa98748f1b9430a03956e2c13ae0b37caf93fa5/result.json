  "first_valid_proof": "open OldExpressions in\ntheorem extractedOldExprInVars :\n  NormalizedOldExpr post →\n  (extractOldExprVars post).Subset\n  (Imperative.HasVarsPure.getVars post) := by\n  have appendMono {a b c d : List Expression.Ident}\n      (h₁ : a.Subset b) (h₂ : c.Subset d) :\n      (a ++ c).Subset (b ++ d) := by\n    intro x hx\n    simp only [List.mem_append] at hx ⊢\n    rcases hx with hx | hx\n    · exact Or.inl (h₁ hx)\n    · exact Or.inr (h₂ hx)\n  intro Hnorm\n  induction post <;>\n    simp [Imperative.HasVarsPure.getVars, extractOldExprVars,\n          Lambda.LExpr.LExpr.getVars] at * <;>\n    try simp_all\n  case app fn e fn_ih e_ih =>\n    unfold extractOldExprVars\n    split\n    · simp [Lambda.LExpr.LExpr.getVars]\n      intros x Hin\n      exact Hin\n    · next Hfalse =>\n        cases Hnorm with\n        | app H1 H2 Hn =>\n          exfalso\n          specialize Hn ?_\n          constructor\n          cases Hn\n          apply Hfalse\n          rfl\n    · cases Hnorm with\n      | app H1 H2 Hn =>\n        simpa [Imperative.HasVarsPure.getVars, Lambda.LExpr.LExpr.getVars] using\n          appendMono (fn_ih H1) (e_ih H2)\n  case abs ih =>\n    cases Hnorm with\n    | abs hn => exact ih hn\n  case quant trih eih =>\n    cases Hnorm with\n    | quant htr he =>\n      simpa [Imperative.HasVarsPure.getVars, Lambda.LExpr.LExpr.getVars] using\n        appendMono (trih htr) (eih he)\n  case ite cih tih eih =>\n    cases Hnorm with\n    | ite hc ht he =>\n      simpa [Imperative.HasVarsPure.getVars, Lambda.LExpr.LExpr.getVars] using\n        appendMono (cih hc) (appendMono (tih ht) (eih he))\n  case eq ih1 ih2 =>\n    cases Hnorm with\n    | eq h1 h2 =>\n      simpa [Imperative.HasVarsPure.getVars, Lambda.LExpr.LExpr.getVars] using\n        appendMono (ih1 h1) (ih2 h2)\n",
