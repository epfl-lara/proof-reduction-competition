  "proof": "theorem parallelReduction_diamond : Diamond ParallelReduction := by\n  intro a a₁ a₂ h₁ h₂\n  cases h₁\n  case refl => exact ⟨a₂, h₂, .refl a₂⟩\n  case par a a' b b' ha' hb' =>\n    cases h₂\n    case refl => exact ⟨_, .refl _, .par ha' hb'⟩\n    case par a'' b'' ha'' hb'' =>\n      let ⟨a₃, ha⟩ := parallelReduction_diamond ha' ha''\n      let ⟨b₃, hb⟩ := parallelReduction_diamond hb' hb''\n      exact ⟨a₃ ⬝ b₃, .par ha.1 hb.1, .par ha.2 hb.2⟩\n    case red_I =>\n      rw [I_irreducible a' ha']\n      exact ⟨b', .red_I b', hb'⟩\n    case red_K =>\n      let ⟨a₂', ha₂'⟩ := Ka_irreducible a₂ a' ha'\n      rw [ha₂'.2]\n      exact ⟨a₂', .red_K a₂' b', ha₂'.1⟩\n    case red_S a c =>\n      let ⟨a'', c', h⟩ := Sab_irreducible a c a' ha'\n      rw [h.2.2]\n      exact ⟨a'' ⬝ b' ⬝ (c' ⬝ b'), .red_S a'' c' b', by exact .par (.par h.1 hb') (.par h.2.1 hb')⟩\n  case red_I =>\n    cases h₂\n    case refl => exact ⟨a₁, .refl _, .red_I _⟩\n    case par c a₁' hc ha =>\n      rw [I_irreducible c hc]\n      exact ⟨a₁', ha, .red_I _⟩\n    case red_I => exact ⟨a₁, .refl _, .refl _⟩\n  case red_K c =>\n    cases h₂\n    case refl => exact ⟨_, .refl _, .red_K ..⟩\n    case par a' c' ha hc =>\n      obtain ⟨a₁', h'⟩ := Ka_irreducible a₁ a' ha\n      rw [h'.2]\n      exact ⟨a₁', h'.1, .red_K ..⟩\n    case red_K => exact ⟨a₁, .refl _, .refl _⟩\n  case red_S a b c =>\n    cases h₂\n    case refl => exact ⟨a ⬝ c ⬝ (b ⬝ c), .refl _, .red_S ..⟩\n    case par d c' hd hc =>\n      let ⟨a', b', h⟩ := Sab_irreducible a b d hd\n      rw [h.2.2]\n      exact ⟨a' ⬝ c' ⬝ (b' ⬝ c'), .par (.par h.1 hc) (.par h.2.1 hc), .red_S ..⟩\n    case red_S => exact ⟨a ⬝ c ⬝ (b ⬝ c), .refl _, .refl _⟩",
