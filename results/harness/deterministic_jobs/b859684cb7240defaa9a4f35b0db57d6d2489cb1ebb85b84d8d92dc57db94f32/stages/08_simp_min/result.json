  "proof": "theorem InitsUpdatesComm\n  {P : PureExpr} {σ σ' σ'' : SemanticStore P}\n  {ks ks' : List P.Ident} {vs vs' : List P.Expr} :\n  UpdateStates σ ks vs σ' →\n  InitStates σ' ks' vs' σ'' →\n  ∃ σ₁,\n    σ₁ = (updatedStates σ ks' vs') ∧\n    InitStates σ ks' vs' σ₁ ∧\n    UpdateStates σ₁ ks vs σ'' := by\n  intro hu hi\n  refine ⟨_, rfl,\n    updatedStatesInit (InitStatesLength hi) (UpdateStatesNotDefMonotone' (InitStatesNotDefined hi) hu) (InitStatesNodup hi), ?_⟩\n  rw [InitStatesUpdated hi, UpdateStatesUpdated hu]\n  unfold updatedStates\n  rw [updatedStatesComm]\n  · exact updatedStatesUpdate (UpdateStatesLength hu) (updatedStatesDefMonotone (UpdateStatesDefined' hu))\n  · rw [List.unzip_zip (UpdateStatesLength hu), List.unzip_zip (InitStatesLength hi)]\n    intro k hk hk'\n    exact Option.isSome_iff_ne_none.mp (UpdateStatesDefined hu k hk) ((InitStatesNotDefined hi) k hk')",
