  "proof": "theorem parallelReduction_diamond : Diamond ParallelReduction := by\n  intro a a₁ a₂ h₁ h₂\n  induction h₁ generalizing a₂\n  case refl => exact ⟨_, h₂, .refl _⟩\n  all_goals cases h₂\n  case' par.red_I | par.red_K | par.red_S => apply symm\n  case red_I.par | par.red_I =>\n    obtain rfl := I_irreducible _ (by assumption)\n    exact ⟨_, by assumption, .red_I _⟩\n  case red_K.par | par.red_K =>\n    obtain ⟨a', h, rfl⟩ := Ka_irreducible _ _ (by assumption)\n    exact ⟨_, h, .red_K ..⟩\n  case red_S.par | par.red_S =>\n    obtain ⟨a', b', ha, hb, rfl⟩ := Sab_irreducible _ _ _ (by assumption)\n    refine ⟨_, ?_, .red_S ..⟩\n    exact .par (.par ha (by assumption)) (.par hb (by assumption))\n  case par.par ha hb iha ihb a' b' ha' hb' =>\n    obtain ⟨a', h, h'⟩ := iha ha'\n    obtain ⟨b', k, k'⟩ := ihb hb'\n    exact ⟨_, .par h k, .par h' k'⟩\n  all_goals exact ⟨_, .refl _, by constructor <;> assumption⟩",
