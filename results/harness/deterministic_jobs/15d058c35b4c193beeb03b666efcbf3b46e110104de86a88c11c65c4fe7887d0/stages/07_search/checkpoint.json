  "proof": "theorem bisimilarity_congr_choice :\n    (p ~[lts (defs := defs)] q) → (choice p r) ~[lts (defs := defs)] (choice q r) := by\n  intro h\n  refine ⟨ChoiceBisim, .choice h, ?_⟩\n  intro a b hr μ\n  cases hr <;> rename_i h\n  case' choice => constructor <;> intro s ht <;> cases ht\n  case' bisim => constructor <;> intro s ht\n  all_goals\n    first\n    | exact ⟨s, .choiceR ‹_›, .bisim (HomBisimilarity.refl s)⟩\n    | obtain ⟨t, ht, hh⟩ := (by first | exact h.follow_fst ‹_› | exact h.follow_snd ‹_›)\n      refine ⟨t, ?_, .bisim hh⟩\n      first | exact ht | exact .choiceL ht",
