  "proof": "theorem parallelReduction_diamond : Diamond ParallelReduction := by\n  intro a a₁ a₂ h₁\n  revert a₂\n  induction h₁ <;> intro a₂ h₂\n  case refl =>\n    exact ⟨_, h₂, .refl _⟩\n  case par ha' hb' ih₁ ih₂ =>\n    cases h₂\n    case refl => exact ⟨_, .refl _, .par ha' hb'⟩\n    case par a'' b'' ha'' hb'' =>\n      rcases ih₁ ha'' with ⟨a₃, ha, ha'₃⟩\n      rcases ih₂ hb'' with ⟨b₃, hb, hb'₃⟩\n      exact ⟨_, .par ha hb, .par ha'₃ hb'₃⟩\n    case red_I =>\n      cases I_irreducible _ ha'\n      exact ⟨_, .red_I _, hb'⟩\n    case red_K x y =>\n      obtain ⟨_, h', rfl⟩ := Ka_irreducible _ _ ha'\n      exact ⟨_, .red_K _ _, h'⟩\n    case red_S a c =>\n      obtain ⟨_, _, ha, hc, rfl⟩ := Sab_irreducible _ _ _ ha'\n      exact ⟨_, .red_S .., .par (.par ha hb') (.par hc hb')⟩\n  case red_I =>\n    cases h₂\n    case refl => exact ⟨_, .refl _, .red_I _⟩\n    case par c a₁' hc ha =>\n      cases I_irreducible c hc\n      exact ⟨_, ha, .red_I _⟩\n    case red_I => exact ⟨_, .refl _, .refl _⟩\n  case red_K x y =>\n    cases h₂\n    case refl => exact ⟨_, .refl _, .red_K _ _⟩\n    case par a' c' ha hc =>\n      obtain ⟨a₁', h', rfl⟩ := Ka_irreducible x a' ha\n      exact ⟨_, h', .red_K _ _⟩\n    case red_K => exact ⟨_, .refl _, .refl _⟩\n  case red_S x y z =>\n    cases h₂\n    case refl => exact ⟨_, .refl _, .red_S ..⟩\n    case par d c' hd hc =>\n      obtain ⟨a', b', ha, hb, rfl⟩ := Sab_irreducible x y d hd\n      exact ⟨_, .par (.par ha hc) (.par hb hc), .red_S ..⟩\n    case red_S => exact ⟨_, .refl _, .refl _⟩",
