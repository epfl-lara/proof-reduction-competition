  "proof": "open OldExpressions in\ntheorem extractedOldExprInVars :\n  NormalizedOldExpr post →\n  (extractOldExprVars post).Subset\n  (Imperative.HasVarsPure.getVars post) := by\n  have app {a b c d : List Expression.Ident} (h : a.Subset c) (k : b.Subset d) :\n      (a ++ b).Subset (c ++ d) :=\n    List.Subset.app (List.subset_append_of_subset_left _ h)\n      (List.subset_append_of_subset_right _ k)\n  intro h\n  induction h\n  all_goals try exact List.nil_subset _\n  all_goals try assumption\n  all_goals try (expose_names; exact app a_ih a_ih_1)\n  all_goals try (expose_names; exact app (app a_ih a_ih_1) a_ih_2)\n  unfold extractOldExprVars\n  split\n  · exact fun _ hx => hx\n  · next bad =>\n      have hf := ‹IsOldPred _ → IsFvar _› (by constructor)\n      cases hf\n      exfalso\n      apply bad\n      rfl\n  · exact app ‹_› ‹_›",
