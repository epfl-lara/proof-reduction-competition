  "proof": "theorem putnam_1995_a3\n(relation : (Fin 9 → ℤ) → (Fin 9 → ℤ) → Prop)\n(digits_to_num : (Fin 9 → ℤ) → ℤ)\n(hdigits_to_num : digits_to_num = fun dig => ∑ i : Fin 9, (dig i) * 10^i.1)\n(hrelation : ∀ d e : (Fin 9 → ℤ), relation d e ↔ (∀ i : Fin 9, d i < 10 ∧ d i ≥ 0 ∧ e i < 10 ∧ e i ≥ 0) ∧ (∀ i : Fin 9, 7 ∣ (digits_to_num (fun j : Fin 9 => if j = i then e j else d j))))\n: ∀ d e f : (Fin 9 → ℤ), ((relation d e) ∧ (relation e f)) → (∀ i : Fin 9, 7 ∣ d i - f i) := by\n  intro d e f h i\n  have hr (a b : Fin 9 → ℤ) (h : relation a b) (j : Fin 9) :\n      7 ∣ b j * 10 ^ j.1 - a j * 10 ^ j.1 + digits_to_num a := by\n    convert ((hrelation a b).mp h).2 j using 1\n    symm\n    rw [← sub_eq_iff_eq_add, hdigits_to_num]\n    simp only [← Finset.sum_sub_distrib, ite_mul, ite_sub, sub_self,\n      Finset.sum_ite_eq', Finset.mem_univ, if_true]\n  have hs := Finset.dvd_sum (fun j (_ : j ∈ Finset.univ) => hr d e h.1 j)\n  simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_const,\n    Finset.card_univ, Fintype.card_fin,\n    ← congrFun hdigits_to_num e, ← congrFun hdigits_to_num d] at hs\n  change 7 ∣ digits_to_num e - digits_to_num d + 9 * digits_to_num d at hs\n  obtain ⟨s, hs⟩ := hs\n  obtain ⟨a, ha⟩ := hr d e h.1 i\n  obtain ⟨b, hb⟩ := hr e f h.2 i\n  have hi : 7 ∣ (d i - f i) * 10 ^ i.1 := by\n    refine ⟨s - digits_to_num d - a - b, ?_⟩\n    rw [sub_mul]\n    linarith\n  exact (show IsCoprime (7 : ℤ) 10 from ⟨3, -2, rfl⟩).pow_right.dvd_of_dvd_mul_right hi",
