{"kind": "candidate", "round": 0, "trial": 1, "parent_sha256": "277d929f8b5c21e25f7ed396ab0b12f99b218fc21b3da4573f0ef184532de9b6", "proof": "lemma Typing.progress (der : Typing [] t τ) : t.Value ∨ ∃ t', t ⭢βᵛ t' := by\n  generalize eq : [] = Γ at der\n  have der' : Typing Γ t τ := der\n  induction der <;> subst eq\n  case var mem => grind\n  case app t₁ _ _ t₂ l r ih_l ih_r =>\n    right\n    cases ih_l rfl l with\n    | inl val_l =>\n        cases ih_r rfl r with\n        | inl val_r =>\n            obtain ⟨σ, u, h⟩ := l.canonical_form_abs val_l\n            refine ⟨u ^ᵗᵗ t₂, ?_⟩\n            \n            grind\n        | inr red_r =>\n            obtain ⟨t₂', red⟩ := red_r\n            exact ⟨t₁.app t₂', Red.appᵣ val_l red⟩\n    | inr red_l =>\n        obtain ⟨t₁', red⟩ := red_l\n        exact ⟨t₁'.app t₂, Red.appₗ r.wf.2.1 red⟩\n  case tapp σ' d sub ih =>\n    have lcσ : σ'.LC := (sub.wf [] σ' _).2.1.lc\n    cases ih rfl d with\n    | inl val =>\n        obtain ⟨δ, u, h⟩ := d.canonical_form_tabs val\n        exact Or.inr ⟨u ^ᵗᵞ σ', by rw [h]; exact Red.tabs (h ▸ d.wf.2.1) lcσ⟩\n    | inr red =>\n        obtain ⟨u, step⟩ := red\n        exact Or.inr ⟨.tapp u σ', Red.tapp lcσ step⟩\n  case let' t₁ σ t₂ τ L der h ih _ =>\n    have hb : t₂.body := ⟨L, fun x hx => (h x hx).wf.2.1⟩\n    cases ih rfl der with\n    | inl val => exact Or.inr ⟨t₂ ^ᵗᵗ t₁, Red.let_body val hb⟩\n    | inr red =>\n        obtain ⟨t₁', step⟩ := red\n        exact Or.inr ⟨t₁'.let' t₂, Red.let_bind step hb⟩\n  case inl der _ ih =>\n    cases ih rfl der with\n    | inl val => grind\n    | inr red =>\n        obtain ⟨u, step⟩ := red\n        exact Or.inr ⟨.inl u, Red.inl step⟩\n  case inr der _ ih =>\n    cases ih rfl der with\n    | inl val => grind\n    | inr red =>\n        obtain ⟨u, step⟩ := red\n        exact Or.inr ⟨.inr u, Red.inr step⟩\n  case case t₁ σ τ t₂ δ t₃ L der h₂ h₃ ih _ _ =>\n    have hb₂ : t₂.body := ⟨L, fun x hx => (h₂ x hx).wf.2.1⟩\n    have hb₃ : t₃.body := ⟨L, fun x hx => (h₃ x hx).wf.2.1⟩\n    cases ih rfl der with\n    | inl val =>\n        obtain ⟨u, h | h⟩ := der.canonical_form_sum val\n        · subst t₁\n          cases val with\n          | inl vu => exact Or.inr ⟨t₂ ^ᵗᵗ u, Red.case_inl vu hb₂ hb₃⟩\n        · subst t₁\n          cases val with\n          | inr vu => exact Or.inr ⟨t₃ ^ᵗᵗ u, Red.case_inr vu hb₂ hb₃⟩\n    | inr red =>\n        obtain ⟨u, step⟩ := red\n        exact Or.inr ⟨.case u t₂ t₃, Red.case step hb₂ hb₃⟩\n  case sub der sub ih => exact ih rfl der\n  case abs σ body τ L h ih =>\n    grind\n  case tabs L h ih =>\n    grind", "edits": [{"start": 447, "end": 452, "replacement": "", "reason": "linter.unusedTactic"}], "evaluation": {"status": "passed", "scores": {"length_reduction_pct": -29.41176470588236, "heartbeat_reduction_pct": 97.88379033980584, "compatibility_pct": 100.0, "combined_pct": 56.157341877974496}, "candidate": {"length": 528, "code_sha256": "945cff215b7f3567275b53a2b63fb9736882f65e6826aa020d0c8350091b9c9d"}, "primary_version": "v4.33.0-rc2", "per_version": {"v4.33.0-rc2": {"status": "passed", "passed": true, "heartbeats": 1266.204, "heartbeat_reduction_pct": 97.88379033980584, "cached": true, "environment_fingerprint": "902239d64789e607c7f5c5229206085fbc228fe17cd61979588098ae70c76298", "elapsed_seconds": 3.2160268928855658, "diagnostics": []}, "v4.32.0": {"status": "passed", "passed": true, "heartbeats": 1309.999, "heartbeat_reduction_pct": 97.88582715542506, "cached": false, "environment_fingerprint": "529cbf7e1bc7d38a0a6bbe7b564cd4b44182b22dba3ad2aecb8fc583c0e29bf9", "elapsed_seconds": 3.4970747251063585, "diagnostics": []}, "v4.31.0": {"status": "passed", "passed": true, "heartbeats": 1309.616, "heartbeat_reduction_pct": 97.88614072426526, "cached": false, "environment_fingerprint": "dcc7dc0ef2ca3898ab488c3b07c311a472571d922c0889951bbbface33734bc6", "elapsed_seconds": 3.5549612529575825, "diagnostics": []}}}, "primary_upper_bound": 56.15734187797449, "all_versions_requested": true, "improves_i