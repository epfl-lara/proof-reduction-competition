  "proof": "theorem bisimilarity_congr_choice :\n    (p ~[lts (defs := defs)] q) → (choice p r) ~[lts (defs := defs)] (choice q r) := by\n  intro h\n  refine ⟨@ChoiceBisim _ _ defs, .choice h, ?_⟩\n  intro a b hr μ\n  cases hr with\n  | choice h =>\n    constructor\n    · intro s ht\n      cases ht with\n      | choiceL ht =>\n        obtain ⟨t, ht, hh⟩ := h.follow_fst ht\n        exact ⟨t, .choiceL ht, .bisim hh⟩\n      | choiceR ht => exact ⟨_, .choiceR ht, .bisim (HomBisimilarity.refl _)⟩\n    · intro s ht\n      cases ht with\n      | choiceL ht =>\n        obtain ⟨t, ht, hh⟩ := h.follow_snd ht\n        exact ⟨t, .choiceL ht, .bisim hh⟩\n      | choiceR ht => exact ⟨_, .choiceR ht, .bisim (HomBisimilarity.refl _)⟩\n  | bisim h =>\n    constructor\n    · intro s ht\n      obtain ⟨t, ht, hh⟩ := h.follow_fst ht\n      exact ⟨t, ht, .bisim hh⟩\n    · intro s ht\n      obtain ⟨t, ht, hh⟩ := h.follow_snd ht\n      exact ⟨t, ht, .bisim hh⟩",
