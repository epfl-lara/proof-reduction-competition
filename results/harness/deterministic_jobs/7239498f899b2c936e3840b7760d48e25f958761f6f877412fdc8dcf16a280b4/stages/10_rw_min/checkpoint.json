  "proof": "theorem InitsUpdatesComm\n  {P : PureExpr} {σ σ' σ'' : SemanticStore P}\n  {ks ks' : List P.Ident} {vs vs' : List P.Expr} :\n  UpdateStates σ ks vs σ' →\n  InitStates σ' ks' vs' σ'' →\n  ∃ σ₁,\n    σ₁ = (updatedStates σ ks' vs') ∧\n    InitStates σ ks' vs' σ₁ ∧\n    UpdateStates σ₁ ks vs σ'' := by\n  intro Hup Hinit\n  have Hlen := UpdateStatesLength Hup\n  have Hzip : (ks.zip vs).unzip.1.Disjoint (ks'.zip vs').unzip.1 := by\n    rw [List.unzip_zip Hlen, List.unzip_zip (InitStatesLength Hinit)]\n    intro k hk hk'\n    simpa [InitStatesNotDefined Hinit k hk'] using\n      (UpdateStatesDefined Hup k hk)\n  have Hupdate := updatedStatesUpdate (σ:=updatedStates σ ks' vs') Hlen\n    (updatedStatesDefMonotone (σ:=σ) (ves:=ks'.zip vs') (UpdateStatesDefined' Hup))\n  have Hend : updatedStates (updatedStates σ ks' vs') ks vs = σ'' := by\n    calc\n      _ = updatedStates (updatedStates σ ks vs) ks' vs' := by\n        simpa only [updatedStates] using (updatedStatesComm Hzip).symm\n      _ = σ'' := by\n        simpa only [← UpdateStatesUpdated Hup, ← InitStatesUpdated Hinit]\n  exact ⟨updatedStates σ ks' vs', rfl,\n    updatedStatesInit (InitStatesLength Hinit)\n      (UpdateStatesNotDefMonotone' (InitStatesNotDefined Hinit) Hup)\n      (InitStatesNodup Hinit), Hend ▸ Hupdate⟩",
