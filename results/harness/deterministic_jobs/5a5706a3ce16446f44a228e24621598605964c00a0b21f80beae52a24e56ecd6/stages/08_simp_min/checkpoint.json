  "proof": "theorem putnam_1995_a3\n(relation : (Fin 9 → ℤ) → (Fin 9 → ℤ) → Prop)\n(digits_to_num : (Fin 9 → ℤ) → ℤ)\n(hdigits_to_num : digits_to_num = fun dig => ∑ i : Fin 9, (dig i) * 10^i.1)\n(hrelation : ∀ d e : (Fin 9 → ℤ), relation d e ↔ (∀ i : Fin 9, d i < 10 ∧ d i ≥ 0 ∧ e i < 10 ∧ e i ≥ 0) ∧ (∀ i : Fin 9, 7 ∣ (digits_to_num (fun j : Fin 9 => if j = i then e j else d j))))\n: ∀ d e f : (Fin 9 → ℤ), ((relation d e) ∧ (relation e f)) → (∀ i : Fin 9, 7 ∣ d i - f i) := by\n  have swap (a b : Fin 9 → ℤ) (i : Fin 9) :\n      digits_to_num (fun j => if j = i then b j else a j) =\n        b i * 10 ^ i.1 - a i * 10 ^ i.1 + digits_to_num a := by\n    apply eq_add_of_sub_eq\n    simp only [hdigits_to_num, ← Finset.sum_sub_distrib, ite_mul, ite_sub,\n      sub_self, Fintype.sum_ite_eq']\n  intro d e f h i\n  have hd := ((hrelation d e).mp h.1).2\n  have he := ((hrelation e f).mp h.2).2\n  simp only [swap] at hd he\n  have hs := Finset.dvd_sum (fun j (_ : j ∈ Finset.univ) => hd j)\n  rw [Finset.sum_add_distrib, Finset.sum_sub_distrib,\n    ← congrFun hdigits_to_num e, ← congrFun hdigits_to_num d, Fin.sum_const] at hs\n  have hc : IsCoprime (7 : ℤ) 10 := ⟨3, -2, rfl⟩\n  apply (hc.pow_right (n := i.1)).dvd_of_dvd_mul_right\n  convert dvd_sub hs (dvd_add (dvd_add (hd i) (he i))\n    (dvd_mul_right (7 : ℤ) (digits_to_num d))) using 1 <;> ring1",
