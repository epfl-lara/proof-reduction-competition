  "proof": "lemma Typing.progress (der : Typing [] t τ) : t.Value ∨ ∃ t', t ⭢βᵛ t' := by\n  generalize eq : [] = Γ at der\n  let der' := der\n  induction der <;> subst eq\n  case var mem => cases mem\n  case abs | tabs => left; constructor; exact der'.wf.2.1\n  case app t₁ _ _ t₂ l r ih_l ih_r =>\n    specialize ih_l rfl\n    specialize ih_r rfl\n    grind only [→ l.canonical_form_abs, → wf, → Red.abs,\n      → Red.appₗ (t₁ := t₁), → Red.appᵣ (t₂ := t₂)]\n  case tapp d _ ih =>\n    cases der'.wf.2.1 with | tapp _ lc =>\n      specialize ih rfl\n      grind only [→ d.canonical_form_tabs, → Red.tabs, → Red.tapp]\n  case let' ih _ =>\n    specialize ih rfl\n    grind only [body_let.mp der'.wf.2.1, → Red.let_body, → Red.let_bind]\n  case inl | inr | sub =>\n    rename_i ih\n    specialize ih rfl\n    grind only [Value.inl, Value.inr, → Red.inl, → Red.inr]\n  case case t₁ _ _ _ _ _ _ d _ _ ih _ _ =>\n    specialize ih rfl\n    grind only [body_case.mp der'.wf.2.1, → d.canonical_form_sum, cases Value, → Red.case (t₁ := t₁),\n      → Red.case_inl, → Red.case_inr]",
