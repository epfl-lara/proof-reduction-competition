pow (c := ℓ - i) (a := j) (b := ℓ - (↑i + 1)) (i := 1)\n      · omega\n      · omega\n    ⟩)\n  have h_eval (k : Fin 2) :\n      (AdditiveNTT.qMap 𝔽q β ⟨i, by omega⟩).eval (fiberMap k).val = y := by\n    have h := iteratedQuotientMap_k_eq_1_is_qMap 𝔽q β h_ℓ_add_R_rate i (by omega) (fiberMap k)\n    simp only [Subtype.eq_iff] at h\n    rw [h.symm]\n    have h_res := is_fiber_iff_generates_quotient_point 𝔽q β i (steps := 1) (by omega)\n      (x := fiberMap k) (y := y).mpr (by rw [pointToIterateQuotientIndex_qMap_total_fiber_eq_self])\n    rw [h_res]\n  have hx₀ := qMap_total_fiber_basis_sum_repr 𝔽q β i (steps := 1)\n    (h_i_add_steps := by omega) y 0\n  have hx₁ := qMap_total_fiber_basis_sum_repr 𝔽q β i (steps := 1)\n    (h_i_add_steps := by omega) y 1\n  simp only [Fin.isValue] at hx₀ hx₁\n\n  have h_fiber_diff : x₁.val - x₀.val = 1 := by\n    simp only [Fin.isValue, x₁, fiberMap, x₀]\n    rw [hx₁, hx₀]\n    simp only [Fin.isValue, AddSubmonoidClass.coe_finset_sum, SetLike.val_smul]\n    have h_index : ℓ + 𝓡 - i = (ℓ + 𝓡 - (i.val + 1)) + 1 := by omega\n    rw! (castMode := .all) [h_index]\n    rw [Fin.sum_univ_succ, Fin.sum_univ_succ] -- (free_term + y_repr) - (free_term + y_repr) = 1\n    -- First, simplify the free terms\n    simp only [fiber_coeff, eqRec_eq_cast, lt_one_iff, reducePow, Fin.isValue, Fin.coe_ofNat_eq_mod, mod_succ,\n    dite_smul, ite_smul, zero_smul, one_smul, zero_mod]\n    have h_cast_0 :\n        (cast (Eq.symm h_index ▸ rfl : Fin (ℓ + 𝓡 - (↑i + 1) + 1) = Fin (ℓ + 𝓡 - ↑i)) 0).val =\n        0 := by\n      rw [←Fin.cast_eq_cast (h := by omega)]\n      rw [Fin.cast_val_eq_val (h_eq := by omega)]\n      simp only [Fin.coe_ofNat_eq_mod, mod_succ_eq_iff_lt]\n      omega\n    \n    simp only [h_cast_0, ↓reduceDIte]\n    have h_getBit_0_of_0 : Nat.getBit (k := 0) (n := 0) = 0 := by\n      decide\n    have h_getBit_0_of_1 : Nat.getBit (k := 0) (n := 1) = 1 := by\n      decide\n    simp only [h_getBit_0_of_1, one_ne_zero, ↓reduceIte, h_getBit_0_of_0, zero_add]\n    rw! (castMode := .all) [←h_index]\n    \n    simp only [cast_eq, get_sDomain_basis, Fin.coe_ofNat_eq_mod, zero_mod, add_zero]\n    rw [normalizedWᵢ_eval_βᵢ_eq_1 𝔽q β]\n    ring_nf\n    conv_rhs => rw [←add_zero (a := 1)]\n    rw [add_sub_assoc]\n    congr 1\n    rw [sub_eq_zero]\n    apply Finset.sum_congr (h := by rfl)\n    simp only [mem_univ, congr_eqRec, Fin.val_succ, Nat.add_eq_zero, one_ne_zero, and_false, ↓reduceDIte,\n    add_tsub_cancel_right, Fin.eta, imp_self, implies_true]\n  set P_i_plus_1 :=\n    intermediateEvaluationPoly 𝔽q β h_ℓ_add_R_rate (i := ⟨i+1, by omega⟩) new_coeffs\n  set P₀ := evenRefinement 𝔽q β h_ℓ_add_R_rate i coeffs\n  set P₁ := oddRefinement 𝔽q β h_ℓ_add_R_rate i coeffs\n  have h_P_i_eval := evaluation_poly_split_identity 𝔽q β h_ℓ_add_R_rate ⟨i, by omega⟩ coeffs\n  -- Equation 39 : P^(i)(X) = P₀^(i+1)(q^(i)(X)) + X · P₁^(i+1)(q^(i)(X))\n  have h_equation_39_x₀ : P_i.eval x₀.val = P₀.eval y.val + x₀.val * P₁.eval y.val := by\n    simp only [h_P_i_eval, Fin.eta, Polynomial.eval_add, eval_comp, h_eval 0, Polynomial.eval_mul,\n    Polynomial.eval_X, x₀, P_i, P₀, P₁]\n  have h_equation_39_x₁ : P_i.eval x₁.val = P₀.eval y.val + x₁.val * P₁.eval y.val := by\n    simp only [h_P_i_eval, Fin.eta, Polynomial.eval_add, eval_comp, h_eval 1, Polynomial.eval_mul,\n    Polynomial.eval_X, x₁, P_i, P₀, P₁]\n  set f_i := fun (x : (sDomain 𝔽q β h_ℓ_add_R_rate) ⟨i, by omega⟩) => P_i.eval (x.val : L)\n  set f_i_plus_1 := fold (i := ⟨i, by omega⟩) (h_i := by omega) (f := f_i) (r_chal := r_chal)\n  -- Unfold the definition of f_i_plus_1 using the fold function\n  \n  -- Main calculation following the outline\n  calc f_i_plus_1 y\n    = f_i x₀ * ((1 - r_chal) * x₁.val - r_chal) +\n        f_i x₁ * (r_chal - (1 - r_chal) * x₀.val) := rfl\n    _ = P_i.eval x₀.val * ((1 - r_chal) * x₁.val - r_chal) +\n        P_i.eval x₁.val * (r_chal - (1 - r_chal) * x₀.val) := by dsimp only\n    _ = (P₀.eval y.val + x₀.val * P₁.eval y.val) * ((1 - r_chal) * x₁.val - r_chal) +\n        (P₀.eval y.val + x₁.val * P₁.eval y.val) * (r_chal - (1 - r_chal) * x₀.val) := by\n      rw [h_equation_39_x₀, h_equation_39_x₁]\n    _ = P₀.eval y.val * ((1 - r_chal) * (x₁.val - x₀.val)) +\n        P₁.eval y.val * ((x₁.val - x₀.val) * r_chal) := by ring\n    _ = P₀.eval y.val * (1 - r_chal) + P₁.eval y.val * r_chal := by rw [h_fiber_diff]; ring\n    _ = P_i_plus_1.eval y.val := by\n      simp only [evenRefinement, eval_finset_sum, Polynomial.eval_mul, Polynomial.eval_C, sum_mul, oddRefinement,\n    ← sum_add_distrib, intermediateEvaluationPoly, P₀, P₁, P_i_plus_1, new_coeffs]\n      apply Finset.sum_congr rfl\n      intro j hj\n      ring", "edits": [{"start": 1224, "end": 1233, "replacement": "simp only", "reason": "explicit_simp_lemmas"}, {"start": 1343, "end": 1352, "replacement": "simp only", "reason": "explicit_simp_lemmas"}, {"start": 2113, "end": 2144, "replacement": "simp only [Subtype.eq_iff] at h", "reason": "explicit_simp_lemmas"}, {"start": 2569, "end": 2603, "replacement": "simp only [Fin.isValue] at hx₀ hx₁", "reason": "explicit_simp_lemmas"}, {"start": 2657, "end": 2698, "replacement": "simp only [Fin.isValue, x₁, fiberMap, x₀]", "reason": "explicit_simp_lemmas"}, {"start": 2721, "end": 2796, "replacement": "simp only [Fin.isValue, AddSubmonoidClass.coe_finset_sum, SetLike.val_smul]", "reason": "explicit_simp_lemmas"}, {"start": 3042, "end": 3206, "replacement": "simp only [fiber_coeff, eqRec_eq_cast, lt_one_iff, reducePow, Fin.isValue, Fin.coe_ofNat_eq_mod, mod_succ,\n    dite_smul, ite_smul, zero_smul, one_smul, zero_mod]", "reason": "explicit_simp_lemmas"}, {"start": 3439, "end": 3491, "replacement": "simp only [Fin.coe_ofNat_eq_mod, mod_succ_eq_iff_lt]", "reason": "explicit_simp_lemmas"}, {"start": 3513, "end": 3546, "replacement": "simp only [h_cast_0, ↓reduceDIte]", "reason": "explicit_simp_lemmas"}, {"start": 3709, "end": 3788, "replacement": "simp only [h_getBit_0_of_1, one_ne_zero, ↓reduceIte, h_getBit_0_of_0, zero_add]