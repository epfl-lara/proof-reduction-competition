  "code": "lemma fundamental_theorem_of_variational_calculus' {f : Y → V}\n    (μ : Measure Y) [IsFiniteMeasureOnCompacts μ] [μ.IsOpenPosMeasure]\n    [OpensMeasurableSpace Y]\n    (hf : Continuous f) (hg : ∀ g, IsTestFunction g → ∫ x, ⟪f x, g x⟫_ℝ ∂μ = 0) :\n    f = 0 := by\n  funext x₀\n  by_contra hx₀\n  let k : Y → ℝ := fun x => ⟪f x, f x₀⟫_ℝ\n  have hc : Continuous k := Continuous.inner' f (fun _ => f x₀) hf continuous_const\n  have hpos : 0 < k x₀ :=\n    real_inner_self_nonneg'.lt_of_ne' (inner_self_eq_zero'.not.mpr hx₀)\n  obtain ⟨φ, hφs, hφc, hφd, hφn, hφx⟩ :=\n    exists_contDiff_tsupport_subset (n := ⊤)\n      (hc.continuousAt.preimage_mem_nhds (Ioi_mem_nhds hpos))\n  have htest : IsTestFunction (fun x => φ x • f x₀) :=\n    by\n      constructor\n      · profile_tactic \"smooth\" in exact hφd.smul_const (f x₀)\n      · profile_tactic \"support\" in exact hφc.smul_right\n  have hi := hg _ htest\n  simp only [inner_smul_right'] at hi\n  refine ((hφd.continuous.mul hc).integral_pos_of_hasCompactSupport_nonneg_nonzero\n    hφc.mul_right ?_ (mul_ne_zero (hφx.trans_ne one_ne_zero) hpos.ne')).ne' hi\n  intro x\n  by_cases hx : φ x = 0\n  · simp only [Pi.zero_apply, Pi.mul_apply, hx, zero_mul, le_refl]\n  · exact mul_nonneg (hφn (Set.mem_range_self x)).1\n      (hφs (subset_tsupport φ hx)).le\n",
