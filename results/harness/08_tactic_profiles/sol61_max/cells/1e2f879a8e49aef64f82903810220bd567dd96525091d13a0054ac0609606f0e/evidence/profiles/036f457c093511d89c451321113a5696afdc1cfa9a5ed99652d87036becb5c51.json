  "code": "theorem bisimilarity_congr_choice :\n    (p ~[lts (defs := defs)] q) → (choice p r) ~[lts (defs := defs)] (choice q r) := by\n  intro h\n  rw [HomBisimilarity.symm_simulation]\n  refine ⟨@ChoiceBisim _ _ defs, ChoiceBisim.choice h, ⟨?_⟩, ?_⟩\n  · rintro s t (hb | hb) <;> constructor <;> exact hb.symm\n  · rintro s1 s2 (hb | hb) μ s' ht\n    case' choice => cases ht <;> rename_i ht\n    case choiceR =>\n      exact ⟨s', Tr.choiceR ht, ChoiceBisim.bisim (HomBisimilarity.refl _)⟩\n    all_goals\n      obtain ⟨t, ht, hh⟩ := hb.follow_fst ht\n      refine ⟨t, ?_, ChoiceBisim.bisim hh⟩\n      first | exact ht | exact Tr.choiceL ht\n",
