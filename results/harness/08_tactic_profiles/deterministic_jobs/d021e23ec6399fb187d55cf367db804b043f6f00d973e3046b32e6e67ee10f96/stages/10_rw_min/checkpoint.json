  "proof": "theorem putnam_1964_a4\n(u : ℕ → ℤ)\n(boundedu : ∃ B T : ℤ, ∀ n : ℕ, B ≤ u n ∧ u n ≤ T)\n(hu : ∀ n ≥ 4, u n = ((u (n - 1) + u (n - 2) + u (n - 3) * u (n - 4)) : ℝ) / (u (n - 1) * u (n - 2) + u (n - 3) + u (n - 4)) ∧ (u (n - 1) * u (n - 2) + u (n - 3) + u (n - 4)) ≠ 0)\n: (∃ N c : ℕ, c > 0 ∧ ∀ n ≥ N, u (n + c) = u n) := by\n  obtain ⟨B, T, hB⟩ := boundedu\n  obtain ⟨i, j, hij, heq⟩ :=\n    (Set.Finite.pi' fun _ : Fin 4 => Set.finite_Icc B T).exists_lt_map_eq_of_forall_mem\n      (f := fun n : ℕ => fun k : Fin 4 => u (n + k)) (by tauto)\n  have h m : u (i + m) = u (j + m) :=\n    Nat.strong_induction_on m fun m ih => by\n      by_cases hm : m < 4\n      · exact congrFun heq ⟨m, hm⟩\n      · apply Int.cast_injective (α := ℝ)\n        rw [(hu (i + m) (by omega)).1, (hu (j + m) (by omega)).1]\n        simp (disch := omega) only [Nat.add_sub_assoc, ih]\n  refine ⟨i, j - i, Nat.sub_pos_of_lt hij, ?_⟩\n  intro n hn\n  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hn\n  rw [Nat.add_right_comm, Nat.add_sub_of_le hij.le]\n  exact (h m).symm",
