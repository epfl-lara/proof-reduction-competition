  "proof": "theorem InitsUpdatesComm\n  {P : PureExpr} {σ σ' σ'' : SemanticStore P}\n  {ks ks' : List P.Ident} {vs vs' : List P.Expr} :\n  UpdateStates σ ks vs σ' →\n  InitStates σ' ks' vs' σ'' →\n  ∃ σ₁,\n    σ₁ = (updatedStates σ ks' vs') ∧\n    InitStates σ ks' vs' σ₁ ∧\n    UpdateStates σ₁ ks vs σ'' := by\n  intro hu hi\n  have hl := UpdateStatesLength hu\n  have hl' := InitStatesLength hi\n  refine ⟨_, rfl,\n    updatedStatesInit hl' (UpdateStatesNotDefMonotone' (InitStatesNotDefined hi) hu)\n      (InitStatesNodup hi), ?_⟩\n  rewrite [InitStatesUpdated hi, UpdateStatesUpdated hu]\n  unfold updatedStates\n  rewrite [updatedStatesComm]\n  · exact updatedStatesUpdate hl (updatedStatesDefMonotone (UpdateStatesDefined' hu))\n  · rewrite [List.unzip_zip hl, List.unzip_zip hl']\n    intro k hk hk'\n    cases (InitStatesNotDefined hi k hk') ▸ UpdateStatesDefined hu k hk",
