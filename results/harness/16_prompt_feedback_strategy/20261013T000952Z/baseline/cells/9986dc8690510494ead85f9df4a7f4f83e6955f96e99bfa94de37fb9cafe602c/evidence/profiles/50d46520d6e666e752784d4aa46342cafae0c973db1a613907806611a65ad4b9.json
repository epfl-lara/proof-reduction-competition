  "code": "lemma Typing.progress (der : Typing [] t τ) : t.Value ∨ ∃ t', t ⭢βᵛ t' := by\n  have lc := der.wf.2.1\n  generalize eq : [] = Γ at der\n  induction der <;> subst eq\n  case app l r il ir =>\n    right\n    cases lc with | app ll lr =>\n      rcases il ll rfl with v | ⟨u, h⟩\n      · grind only [l.canonical_form_abs v, → Red.abs, → Red.appᵣ v]\n      · exact ⟨_, .appₗ lr h⟩\n  case tapp =>\n    cases lc <;> grind only [→ canonical_form_tabs, → Red.tabs, → Red.tapp]\n  case let' =>\n    grind only [body_let, → Red.let_body, → Red.let_bind]\n  case case d _ _ ih _ _ =>\n    right\n    have body := (body_case.mp lc).2\n    rcases ih d.wf.2.1 rfl with v | ⟨u, h⟩\n    · grind only [d.canonical_form_sum v, cases Value, → Red.case_inl, → Red.case_inr]\n    · exact ⟨_, .case h body.1 body.2⟩\n  all_goals grind [→ Red.inl, → Red.inr]\n",
