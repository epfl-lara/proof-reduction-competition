  "code": "lemma Typing.progress (der : Typing [] t τ) : t.Value ∨ ∃ t', t ⭢βᵛ t' := by\n  have lc := der.wf.2.1\n  generalize eq : [] = Γ at der\n  induction der <;> subst eq\n  case var mem => cases mem\n  case abs | tabs => left; constructor; exact lc\n  case sub ih => exact ih lc rfl\n  case app l r il ir =>\n    right\n    cases lc with | app ll lr =>\n      rcases il ll rfl with v | ⟨u, h⟩\n      · have := l.canonical_form_abs v\n        have := ir lr rfl\n        grind only [→ Red.abs, → Red.appᵣ]\n      · exact ⟨_, .appₗ lr h⟩\n  case tapp d s ih =>\n    cases lc with | tapp lt ls =>\n      have := ih lt rfl\n      grind only [→ canonical_form_tabs, → Value.lc, → Red.tabs, → Red.tapp]\n  case let' d _ ih _ =>\n    have body := body_let.mp lc\n    have := ih body.1 rfl\n    grind only [→ Red.let_body, → Red.let_bind]\n  case inl d _ ih | inr d _ ih =>\n    rcases ih d.wf.2.1 rfl with v | ⟨u, h⟩ <;>\n      grind only [→ Value.inl, → Value.inr, → Red.inl, → Red.inr]\n  case case d _ _ ih _ _ =>\n    right\n    have body := (body_case.mp lc).2\n    rcases ih d.wf.2.1 rfl with v | ⟨u, h⟩\n    · have := d.canonical_form_sum v\n      grind only [cases Value, → Red.case_inl, → Red.case_inr]\n    · exact ⟨_, .case h body.1 body.2⟩\n",
