  "code": "theorem bisimilarity_congr_choice :\n    (p ~[lts (defs := defs)] q) → (choice p r) ~[lts (defs := defs)] (choice q r) := by\n  intro h\n  exists ChoiceBisim, ChoiceBisim.choice h\n  rintro s t (h | h) μ <;>\n    refine (Bisimilarity.isBisimulation _ _ h μ).imp ?_ ?_ <;> intro hf s' ht\n  case' choice | choice => cases ht\n  case choiceR | choiceR => use s', Tr.choiceR ‹_›, ChoiceBisim.bisim (HomBisimilarity.refl _)\n  all_goals exact (hf _ ‹_›).imp fun _ => And.imp (by first | exact Tr.choiceL | exact id) ChoiceBisim.bisim\n",
