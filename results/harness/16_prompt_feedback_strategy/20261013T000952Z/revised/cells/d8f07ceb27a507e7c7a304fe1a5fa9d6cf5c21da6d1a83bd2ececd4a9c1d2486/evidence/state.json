  "best_proof": "lemma ι_timeOrderF_superCommuteF_eq_time {φ ψ : 𝓕.CrAnFieldOp}\n    (hφψ : crAnTimeOrderRel φ ψ) (hψφ : crAnTimeOrderRel ψ φ) (a b : 𝓕.FieldOpFreeAlgebra) :\n    ι 𝓣ᶠ(a * [ofCrAnOpF φ, ofCrAnOpF ψ]ₛF * b) =\n    ι ([ofCrAnOpF φ, ofCrAnOpF ψ]ₛF * 𝓣ᶠ(a * b)) := by\n  let c := [ofCrAnOpF φ, ofCrAnOpF ψ]ₛF\n  refine LinearMap.congr_fun₂ (show\n    (mulLinearMap ∘ₗ mulLinearMap.flip c).compr₂ₛₗ (ι.toLinearMap ∘ₗ timeOrderF) =\n      mulLinearMap.compr₂ₛₗ (ι.toLinearMap ∘ₗ mulLinearMap c ∘ₗ timeOrderF) from\n    ofCrAnListFBasis.ext fun xs => ofCrAnListFBasis.ext fun ys => ?_) a b\n  simp only [LinearMap.compr₂ₛₗ_apply, LinearMap.comp_apply,\n    LinearMap.flip_apply, mulLinearMap_apply, AlgHom.toLinearMap_apply, ofListBasis_eq_ofList]\n  obtain ⟨l1, l2, hs⟩ : ∃ l1 l2, ∀ l,\n      (∀ c ∈ l, crAnTimeOrderRel φ c ∧ crAnTimeOrderRel c φ) →\n      crAnTimeOrderList (xs ++ l ++ ys) = l1 ++ l ++ l2 :=\n    ⟨_, _, fun l h =>\n      (insertionSort_of_eq_list 𝓕.crAnTimeOrderRel φ xs l ys h).trans\n        (List.append_assoc _ _ _)⟩\n  simp only [List.append_assoc] at hs\n  rw [← ofCrAnListF_append, timeOrderF_ofCrAnListF, mul_smul_comm]\n  trans ι (crAnTimeOrderSign (xs ++ φ :: ψ :: ys) •\n        (ofCrAnListF l1 * c * ofCrAnListF l2))\n  ·\n      congr 1\n      simp only [c, superCommuteF_ofCrAnOpF_ofCrAnOpF, ← ofCrAnListF_singleton, mul_sub, sub_mul, mul_smul_comm,\n        smul_mul_assoc, ← ofCrAnListF_append, map_sub, map_smul,\n        timeOrderF_ofCrAnListF, List.append_assoc, List.cons_append, List.nil_append]\n      rw [← crAnTimeOrderSign_swap_eq_time hφψ hψφ]\n      erw [hs [φ, ψ] (by simp [hφψ, hψφ]), hs [ψ, φ] (by simp [hφψ, hψφ])]\n      rw [smul_sub, smul_comm]\n      rfl\n  ·\n      simp only [map_smul, map_mul]\n      rw [Subalgebra.mem_center_iff.mp\n        (ι_superCommuteF_ofCrAnOpF_ofCrAnOpF_mem_center φ ψ),\n        mul_assoc, ← map_mul, ← ofCrAnListF_append]\n      erw [← hs [] (by simp)]\n      by_cases hq : (𝓕 |>ₛ φ) = (𝓕 |>ₛ ψ)\n      · rw [crAnTimeOrderSign, Wick.koszulSign_eq_rel_eq_stat _ _ hφψ hψφ\n          hq.symm]\n        rfl\n      · simp only [c, ι_superCommuteF_of_diff_statistic hq, zero_mul, smul_zero]\n",
