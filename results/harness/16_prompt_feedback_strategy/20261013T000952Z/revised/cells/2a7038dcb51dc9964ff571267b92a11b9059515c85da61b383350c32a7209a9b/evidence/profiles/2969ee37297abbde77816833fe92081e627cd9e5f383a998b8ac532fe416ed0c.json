  "code": "lemma fundamental_theorem_of_variational_calculus' {f : Y → V}\n    (μ : Measure Y) [IsFiniteMeasureOnCompacts μ] [μ.IsOpenPosMeasure]\n    [OpensMeasurableSpace Y]\n    (hf : Continuous f) (hg : ∀ g, IsTestFunction g → ∫ x, ⟪f x, g x⟫_ℝ ∂μ = 0) :\n    f = 0 := by\n  funext x₀\n  apply (inner_self_eq_zero' (𝕜 := ℝ)).mp\n  by_contra hx₀\n  have hc := Continuous.inner' (𝕜 := ℝ) f (fun _ => f x₀) hf continuous_const\n  obtain ⟨φ, hs, hk, hd, hφ, hv⟩ := exists_contDiff_tsupport_subset\n    (hc.continuousAt.preimage_mem_nhds (Ici_mem_nhds (lt_of_le_of_ne' real_inner_self_nonneg' hx₀)))\n  refine ((hd.continuous.fun_mul hc).integral_pos_of_hasCompactSupport_nonneg_nonzero\n    hk.mul_right ?_\n    (by rwa [hv, one_mul])).ne'\n      (by\n        simp_rw [← inner_smul_right']\n        apply hg\n        exact IsTestFunction.smul_right ⟨hd, hk⟩ contDiff_const)\n  intro x\n  by_cases hx : φ x = 0\n  · simp [hx]\n  · apply mul_nonneg (hφ ⟨x, rfl⟩).1\n    exact hs (subset_tsupport φ hx)\n",
