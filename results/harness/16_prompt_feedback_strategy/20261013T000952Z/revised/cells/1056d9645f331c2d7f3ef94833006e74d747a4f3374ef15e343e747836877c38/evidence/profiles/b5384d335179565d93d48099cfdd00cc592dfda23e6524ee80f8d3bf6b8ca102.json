  "code": "theorem parallelReduction_diamond : Diamond ParallelReduction := by\n  intro a a₁ a₂ h₁ h₂\n  induction h₁ generalizing a₂\n  case refl =>\n    econstructor\n    exact ⟨h₂, .refl _⟩\n  case' par ha hb iha ihb => skip\n  all_goals cases h₂\n  case par.par ha' hb' =>\n    obtain ⟨_, hc⟩ := iha ha'\n    obtain ⟨_, hd⟩ := ihb hb'\n    econstructor\n    exact ⟨.par hc.1 hd.1, .par hc.2 hd.2⟩\n  case' red_I.par ha hb | red_K.par ha hb | red_S.par ha hb => apply symm\n  case par.red_I | red_I.par =>\n    cases I_irreducible _ ha\n    econstructor\n    exact ⟨.red_I _, hb⟩\n  case par.red_K | red_K.par =>\n    obtain ⟨_, h, rfl⟩ := Ka_irreducible _ _ ha\n    econstructor\n    exact ⟨.red_K .., h⟩\n  case par.red_S | red_S.par =>\n    obtain ⟨_, _, h, h', rfl⟩ := Sab_irreducible _ _ _ ha\n    econstructor\n    exact ⟨.red_S .., .par (.par h hb) (.par h' hb)⟩\n  all_goals repeat' econstructor\n  all_goals assumption\n",
