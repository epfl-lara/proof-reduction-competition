  "best_proof": "theorem parallelReduction_diamond : Diamond ParallelReduction := by\n  intro a a₁ a₂ h₁ h₂\n  induction h₁ generalizing a₂\n  case refl =>\n    econstructor\n    constructor\n    assumption\n    constructor\n  case' par ha hb iha ihb => skip\n  all_goals cases h₂\n  case par.par ha' hb' =>\n    obtain ⟨_, hc⟩ := iha ha'\n    obtain ⟨_, hd⟩ := ihb hb'\n    econstructor\n    constructor\n    exact hc.1.par hd.1\n    exact hc.2.par hd.2\n  case' red_I.par | red_K.par | red_S.par =>\n    rename_i ha hb\n    apply symm\n  case par.red_I | red_I.par =>\n    cases I_irreducible _ ha\n    econstructor\n    constructor\n    apply ParallelReduction.red_I\n    assumption\n  case par.red_K | red_K.par =>\n    obtain ⟨_, h, rfl⟩ := Ka_irreducible _ _ ha\n    econstructor\n    constructor\n    apply ParallelReduction.red_K\n    exact h\n  case par.red_S | red_S.par =>\n    obtain ⟨_, _, h, h', rfl⟩ := Sab_irreducible _ _ _ ha\n    econstructor\n    constructor\n    apply ParallelReduction.red_S\n    exact (h.par hb).par (h'.par hb)\n  iterate 3 all_goals econstructor\n  all_goals assumption",
