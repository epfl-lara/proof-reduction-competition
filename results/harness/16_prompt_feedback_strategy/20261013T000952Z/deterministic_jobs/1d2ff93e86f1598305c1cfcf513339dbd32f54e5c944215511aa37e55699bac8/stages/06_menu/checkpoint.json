  "proof": "theorem fiberwise_dist_lt_imp_dist_lt_unique_decoding_radius (i : Fin ℓ) (steps : ℕ)\n    [NeZero steps] (h_i_add_steps : i.val + steps ≤ ℓ)\n    (f : OracleFunction 𝔽q β (h_ℓ_add_R_rate := h_ℓ_add_R_rate) ⟨i, by omega⟩)\n  (h_fw_dist_lt : fiberwiseClose 𝔽q β (h_ℓ_add_R_rate := h_ℓ_add_R_rate)\n    (i := i) (steps := steps) (h_i_add_steps := h_i_add_steps) (f := f)) :\n  hammingClose 𝔽q β (h_ℓ_add_R_rate := h_ℓ_add_R_rate) ⟨i, by omega⟩ f := by\n  let j : Fin (ℓ + 1) := ⟨i, fin_ℓ_lt_ℓ_add_one i⟩\n  let C := BBF_Code 𝔽q β (h_ℓ_add_R_rate := h_ℓ_add_R_rate) j\n  let S := (fun (g : C) => (fiberwiseDisagreementSet 𝔽q β i steps h_i_add_steps f g).ncard) '' Set.univ\n  obtain ⟨⟨g, hg_mem⟩, _, hg⟩ := Nat.sInf_mem (s := S)\n    (Set.image_nonempty.mpr Set.univ_nonempty)\n  let Y := fiberwiseDisagreementSet 𝔽q β i steps h_i_add_steps f g\n  let Q := qMap_total_fiber 𝔽q β (h_ℓ_add_R_rate := h_ℓ_add_R_rate) ⟨i, fin_ℓ_lt_r (h_ℓ_add_R_rate := h_ℓ_add_R_rate) i⟩\n    steps (fin_ℓ_steps_lt_ℓ_add_R i steps h_i_add_steps)\n  have hcard : hammingDist f g ≤ Y.ncard * 2 ^ steps := by\n    refine (Finset.card_le_card_of_surjOn (s := Y.toFinite.toFinset ×ˢ Finset.univ)\n      (Function.uncurry Q) ?_).trans_eq ?_\n    · intro x hx\n      let y := iteratedQuotientMap 𝔽q β h_ℓ_add_R_rate i steps h_i_add_steps x\n      refine ⟨(y, pointToIterateQuotientIndex 𝔽q β j steps h_i_add_steps x),\n        Finset.mk_mem_product (Y.toFinite.mem_toFinset.mpr ⟨x, rfl, (Finset.mem_filter.mp hx).2⟩)\n          (Finset.mem_univ _), ?_⟩\n      dsimp only [Function.uncurry]\n      exact (is_fiber_iff_generates_quotient_point 𝔽q β i steps h_i_add_steps x y).mp rfl\n    · simp only [Finset.card_product, Finset.card_univ, Fintype.card_fin,\n        ←Set.ncard_eq_toFinset_card]\n  have hb : 2 * Y.ncard ≤ BBF_CodeDistance ℓ 𝓡 ⟨i.val + steps, Nat.lt_succ_of_le h_i_add_steps⟩ - 1 := by\n    change 2 * (↑(sInf S) : ℕ∞) < _ at h_fw_dist_lt\n    rw [←hg] at h_fw_dist_lt\n    exact Nat.le_of_lt_succ (WithTop.coe_lt_coe.1 h_fw_dist_lt)\n  have hnat : 2 * hammingDist f g < BBF_CodeDistance ℓ 𝓡 j := by\n    have h := Nat.mul_le_mul_right (2 ^ steps) hb\n    dsimp only [BBF_CodeDistance, Nat.add_one_sub_one] at h\n    rw [Nat.sub_mul, Nat.sub_add_eq,\n      pow_sub_mul_pow 2 (Nat.le_sub_of_add_le' (h_i_add_steps.trans (Nat.le_add_right _ _))),\n      Nat.sub_add_eq, pow_sub_mul_pow 2 (Nat.le_sub_of_add_le' h_i_add_steps), mul_assoc] at h\n    exact Nat.lt_succ_of_le ((Nat.mul_le_mul_left 2 hcard).trans h)\n  unfold hammingClose\n  exact ((ENat.mul_le_mul_left_iff (a := 2) (by norm_num) (by decide)).2\n    (Code.distFromCode_le_dist_to_mem f (C := C) g hg_mem)).trans_lt\n    (WithTop.coe_lt_coe.2 hnat)",
