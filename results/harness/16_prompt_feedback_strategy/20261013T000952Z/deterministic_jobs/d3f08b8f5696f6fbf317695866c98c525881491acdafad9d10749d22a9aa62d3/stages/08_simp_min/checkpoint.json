  "proof": "theorem fold_advances_evaluation_poly\n  (i : Fin (ℓ)) (h_i_succ_lt : i + 1 < ℓ + 𝓡)\n  (coeffs : Fin (2 ^ (ℓ - ↑i)) → L) (r_chal : L) :\n  let P_i : L[X] := intermediateEvaluationPoly 𝔽q β h_ℓ_add_R_rate (i := ⟨i, by\n    exact Nat.lt_trans (n := i) (k := ℓ+1) (m := ℓ) (h₁ := i.isLt) (by exact Nat.lt_add_one ℓ)\n  ⟩) coeffs\n  let f_i := fun (x : (sDomain 𝔽q β h_ℓ_add_R_rate)\n      ⟨i, by exact Nat.lt_trans (n := i) (k := r) (m := ℓ) (h₁ := by omega) (by omega)⟩) =>\n    P_i.eval (x.val : L)\n  let f_i_plus_1 := fold (i := ⟨i, by omega⟩) (h_i := by omega) (f := f_i) (r_chal := r_chal)\n  let new_coeffs := fun j : Fin (2^(ℓ - (i + 1))) =>\n    (1 - r_chal) * (coeffs ⟨j.val * 2, by\n      rw [←Nat.add_zero (j.val * 2)]\n      apply mul_two_add_bit_lt_two_pow (c := ℓ - i) (a := j) (b := ℓ - (↑i + 1))\n        (i := 0) (by omega) (by omega)\n    ⟩) +\n    r_chal * (coeffs ⟨j.val * 2 + 1, by\n      apply mul_two_add_bit_lt_two_pow (c := ℓ - i) (a := j) (b := ℓ - (↑i + 1))\n        (i := 1) (by omega) (by omega)\n    ⟩)\n  let P_i_plus_1 :=\n    intermediateEvaluationPoly 𝔽q β h_ℓ_add_R_rate (i := ⟨i+1, by omega⟩) new_coeffs\n  ∀ (y : (sDomain 𝔽q β h_ℓ_add_R_rate)\n    ⟨i+1, by omega⟩), f_i_plus_1 y = P_i_plus_1.eval y.val := by\n  intro P_i f_i f_i_plus_1 new_coeffs P_i_plus_1 y\n  let fiberMap := qMap_total_fiber 𝔽q β ⟨i, by omega⟩ 1 h_i_succ_lt y\n  have hq k := congrArg Subtype.val\n    (generates_quotient_point_if_is_fiber_of_y 𝔽q β i 1 i.isLt (fiberMap k) y ⟨k, rfl⟩).symm\n  simp only [iteratedQuotientMap_k_eq_1_is_qMap] at hq\n  have hp : P_i_plus_1 =\n      Polynomial.C (1 - r_chal) * evenRefinement 𝔽q β h_ℓ_add_R_rate i coeffs +\n      Polynomial.C r_chal * oddRefinement 𝔽q β h_ℓ_add_R_rate i coeffs := by\n    dsimp only [P_i_plus_1, new_coeffs, intermediateEvaluationPoly,\n      evenRefinement, oddRefinement]\n    simp only [Polynomial.C_add, Polynomial.C_mul, add_mul,\n      Finset.sum_add_distrib, mul_sum, mul_assoc]\n    rfl\n  change P_i.eval (fiberMap 0).val * _ + P_i.eval (fiberMap 1).val * _ = _\n  simp only [hp, P_i, evaluation_poly_split_identity 𝔽q β h_ℓ_add_R_rate i coeffs,\n    Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_C, eval_comp, hq]\n  simp only [fiberMap, qMap_total_fiber_one_level_eq 𝔽q β i i.isLt y,\n    Fin2ToF2, one_ne_zero, ↓reduceIte, one_smul,\n    zero_smul, zero_add, Submodule.coe_add, get_sDomain_first_basis_eq_1]\n  ring1",
