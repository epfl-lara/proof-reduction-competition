  "seed_proof": "lemma fundamental_theorem_of_variational_calculus' {f : Y → V}\n    (μ : Measure Y) [IsFiniteMeasureOnCompacts μ] [μ.IsOpenPosMeasure]\n    [OpensMeasurableSpace Y]\n    (hf : Continuous f) (hg : ∀ g, IsTestFunction g → ∫ x, ⟪f x, g x⟫_ℝ ∂μ = 0) :\n    f = 0 := by\n  funext x\n  by_contra hx\n  have hc := Continuous.inner' (𝕜 := ℝ) f (fun _ => f x) hf continuous_const\n  have hp :=\n    real_inner_self_nonneg'.lt_of_ne' (inner_self_eq_zero'.not.mpr hx)\n  obtain ⟨φ, hs, hcomp, hcd, hn, hφ⟩ :=\n    exists_contDiff_tsupport_subset ((isOpen_lt continuous_const hc).mem_nhds hp)\n  exact ((hcd.continuous.mul hc).integral_pos_of_hasCompactSupport_nonneg_nonzero\n    hcomp.mul_right (fun y => (hn (Set.mem_range_self y)).1.eq_or_lt'.elim\n      (fun hy => (mul_eq_zero_of_left hy _).ge)\n      (fun hy => (mul_pos hy (hs (subset_closure hy.ne'))).le))\n    (mul_ne_zero (ne_zero_of_eq_one hφ) hp.ne')).ne' (by\n      simpa only [inner_smul_right', Pi.mul_apply] using hg _\n        (IsTestFunction.smul_right ⟨hcd, hcomp⟩\n          (contDiff_const (c := f x))))\n",
