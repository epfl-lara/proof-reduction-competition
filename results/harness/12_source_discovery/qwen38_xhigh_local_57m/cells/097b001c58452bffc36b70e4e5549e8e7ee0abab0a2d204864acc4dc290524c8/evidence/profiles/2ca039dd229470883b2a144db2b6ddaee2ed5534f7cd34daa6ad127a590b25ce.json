  "code": "theorem parallelReduction_diamond : Diamond ParallelReduction := by\n  intro a a₁ a₂ h₁ h₂\n  cases h₁\n  · exact ⟨_, h₂, .refl _⟩\n  all_goals cases h₂\n  case red_I.red_I | red_K.red_K | red_S.red_S => exact ⟨_, .refl _, .refl _⟩\n  case red_I.refl => exact ⟨_, .refl _, .red_I _⟩\n  case red_K.refl => exact ⟨_, .refl _, .red_K _ _⟩\n  case red_S.refl => exact ⟨_, .refl _, .red_S _ _ _⟩\n  case par.refl ha hb => exact ⟨_, .refl _, .par ha hb⟩\n  case red_I.par hc ha => cases hc; exact ⟨_, ha, .red_I _⟩\n  case red_K.par hk _ => obtain ⟨y, hy, rfl⟩ := Ka_irreducible _ _ hk; exact ⟨_, hy, .red_K _ _⟩\n  case red_S.par hs hc =>\n    obtain ⟨x, y, hx, hy, rfl⟩ := Sab_irreducible _ _ _ hs\n    exact ⟨_, .par (.par hx hc) (.par hy hc), .red_S _ _ _⟩\n  case par.red_I hc ha => cases hc; exact ⟨_, .red_I _, ha⟩\n  case par.red_K _ hk => obtain ⟨y, hy, rfl⟩ := Ka_irreducible _ _ hk; exact ⟨_, .red_K _ _, hy⟩\n  case par.red_S hc _ _ hs =>\n    obtain ⟨x, y, hx, hy, rfl⟩ := Sab_irreducible _ _ _ hs\n    exact ⟨_, .red_S _ _ _, .par (.par hx hc) (.par hy hc)⟩\n  case par.par ha hb _ _ ha' hb' =>\n    obtain ⟨x, hx, hx'⟩ := parallelReduction_diamond ha ha'\n    obtain ⟨y, hy, hy'⟩ := parallelReduction_diamond hb hb'\n    exact ⟨_, .par hx hy, .par hx' hy'⟩\n",
