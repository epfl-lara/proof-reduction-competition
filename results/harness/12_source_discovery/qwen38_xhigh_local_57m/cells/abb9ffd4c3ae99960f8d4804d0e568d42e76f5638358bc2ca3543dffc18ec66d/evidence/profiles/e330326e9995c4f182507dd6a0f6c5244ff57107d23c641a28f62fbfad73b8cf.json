  "code": "theorem bisimilarity_congr_choice :\n    (p ~[lts (defs := defs)] q) → (choice p r) ~[lts (defs := defs)] (choice q r) := by\n  intro h\n  refine HomBisimilarity.symm_simulation ▸ ⟨_, ChoiceBisim.choice h, ⟨?_⟩, ?_⟩\n  rintro _ _ (h|h)\n  exact .choice h.symm\n  exact .bisim h.symm\n  rintro a b (hpq|hpq) μ c htr\n  cases htr with\n  | choiceL htr => exact (hpq.follow_fst htr).imp fun _ => And.imp Tr.choiceL ChoiceBisim.bisim\n  | choiceR htr => exact ⟨_, Tr.choiceR htr, .bisim (HomBisimilarity.refl _)⟩\n  exact (hpq.follow_fst htr).imp fun _ => And.imp_right ChoiceBisim.bisim\n",
