  "best_proof": "open OldExpressions in\ntheorem substOldPostSubset:\n  (Imperative.HasVarsPure.getVars (P:=Expression)\n    (substOld h2 (Lambda.LExpr.fvar m h1 ty) post)).Subset\n    (Imperative.HasVarsPure.getVars (P:=Expression) post ++ [h1]) := by\n  have key : ∀ e L, Lambda.LExpr.LExpr.getVars e ⊆ L →\n      Lambda.LExpr.LExpr.getVars (substOld h2 (Lambda.LExpr.fvar m h1 ty) e) ⊆ L ++ [h1] := by\n    intro e L h\n    induction e with\n    | const | bvar | op | fvar => exact List.subset_append_of_subset_left _ h\n    | abs _ _ _ ih => exact ih h\n    | eq _ _ _ ih1 ih2 | quant _ _ _ _ _ ih1 ih2 =>\n        simp only [Lambda.LExpr.LExpr.getVars, List.append_subset] at h\n        exact List.append_subset.mpr ⟨ih1 h.1, ih2 h.2⟩\n    | ite _ _ _ _ ih1 ih2 ih3 =>\n        simp only [Lambda.LExpr.LExpr.getVars, List.append_subset] at h\n        exact List.append_subset.mpr ⟨List.append_subset.mpr ⟨ih1 h.1.1, ih2 h.1.2⟩, ih3 h.2⟩\n    | app _ e1 e2 ih1 ih2 =>\n        dsimp only [substOld]\n        · split\n          · split\n            · exact List.subset_append_right _ _\n            · exact List.subset_append_of_subset_left _ h\n          · exact List.append_subset.mpr\n              ⟨ih1 (List.append_subset.mp h).1, ih2 (List.append_subset.mp h).2⟩\n  exact key post _ (List.Subset.refl _)\n",
