  "proof": "theorem putnam_1964_a4\n(u : ℕ → ℤ)\n(boundedu : ∃ B T : ℤ, ∀ n : ℕ, B ≤ u n ∧ u n ≤ T)\n(hu : ∀ n ≥ 4, u n = ((u (n - 1) + u (n - 2) + u (n - 3) * u (n - 4)) : ℝ) / (u (n - 1) * u (n - 2) + u (n - 3) + u (n - 4)) ∧ (u (n - 1) * u (n - 2) + u (n - 3) + u (n - 4)) ≠ 0)\n: (∃ N c : ℕ, c > 0 ∧ ∀ n ≥ N, u (n + c) = u n) := by\n  obtain ⟨B, T, hB⟩ := boundedu\n  let f := fun n => (u n, u (n + 1), u (n + 2), u (n + 3))\n  have hz : (Set.range f).Finite :=\n    .subset (Set.finite_Icc (B, B, B, B) (T, T, T, T))\n      (Set.range_subset_iff.mpr (by simp only [mem_Icc, Prod.mk_le_mk, hB, and_self, implies_true, f]))\n  obtain ⟨i, j, hij, heq⟩ : ∃ i j, i < j ∧ f i = f j := by\n    by_contra! h\n    exact hz.not_infinite (Set.infinite_range_of_injective fun a b e => by\n      contrapose! e\n      exact (Nat.ne_iff_lt_or_gt.mp e).elim (h a b) fun h2 => (h b a h2).symm)\n  have hr : ∀ n, (u (n + 4) : ℝ) = (fun (a, b, c, d) => (d + c + b * a) / (d * c + b + a)) (f n) :=\n    fun n => (hu (n + 4) (by omega)).1\n  have hp : ∀ m, f (i + m) = f (j + m) := by\n    refine Nat.rec heq fun m ih => ?_\n    have h4 : u (i + m + 4) = u (j + m + 4) := by\n      rw [← Int.cast_inj (α := ℝ), hr, hr, ih]\n    simp only [Prod.mk.injEq, f] at ih ⊢\n    exact ⟨ih.2.1, ih.2.2.1, ih.2.2.2, h4⟩\n  refine ⟨i, j - i, by omega, fun n hn => by\n    obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hn\n    rw [show i + m + (j - i) = j + m from by omega]\n    exact (congrArg Prod.fst (hp m)).symm⟩",
