  "first_valid_proof": "open OldExpressions in\ntheorem substOldPostSubset:\n  (Imperative.HasVarsPure.getVars (P:=Expression)\n    (substOld h2 (Lambda.LExpr.fvar m h1 ty) post)).Subset\n    (Imperative.HasVarsPure.getVars (P:=Expression) post ++ [h1]) := by\n  have gen : ∀ e : Expression.Expr,\n      (Lambda.LExpr.LExpr.getVars (substOld h2 (Lambda.LExpr.fvar m h1 ty) e)).Subset\n        (Lambda.LExpr.LExpr.getVars e ++ [h1]) := by\n    intro e\n    induction e with\n    | const m c | bvar m c =>\n        exact List.subset_append_of_subset_left [h1] (List.Subset.refl _)\n    | op m c t | fvar m c t =>\n        exact List.subset_append_of_subset_left [h1] (List.Subset.refl _)\n    | abs m t e ih =>\n        simpa [substOld, Lambda.LExpr.LExpr.getVars] using ih\n    | quant m qk t tr e ihtr ihe =>\n        simp only [substOld, Lambda.LExpr.LExpr.getVars]\n        refine List.Subset.app ?_ ?_\n        · exact List.Subset.trans ihtr (by intro x hx; simp only [List.mem_append, List.mem_singleton] at hx ⊢; rcases hx with hx | hx <;> simp_all)\n        · exact List.Subset.trans ihe (by intro x hx; simp only [List.mem_append, List.mem_singleton] at hx ⊢; rcases hx with hx | hx <;> simp_all)\n    | app m e1 e2 ih1 ih2 =>\n        simp only [substOld]\n        split\n        · split\n          · intro y hy; simp only [Lambda.LExpr.LExpr.getVars] at hy ⊢; simp_all\n          · exact List.subset_append_of_subset_left [h1] (List.Subset.refl _)\n        · simp only [Lambda.LExpr.LExpr.getVars]\n          refine List.Subset.app ?_ ?_\n          · exact List.Subset.trans ih1 (by intro x hx; simp only [List.mem_append, List.mem_singleton] at hx ⊢; rcases hx with hx | hx <;> simp_all)\n          · exact List.Subset.trans ih2 (by intro x hx; simp only [List.mem_append, List.mem_singleton] at hx ⊢; rcases hx with hx | hx <;> simp_all)\n    | ite m c t f ihc iht ihf =>\n        simp only [substOld, Lambda.LExpr.LExpr.getVars]\n        refine List.Subset.app (List.Subset.app ?_ ?_) ?_\n        · exact List.Subset.trans ihc (by intro x hx; simp only [List.mem_append, List.mem_singleton] at hx ⊢; rcases hx with hx | hx <;> simp_all)\n        · exact List.Subset.trans iht (by intro x hx; simp only [List.mem_append, List.mem_singleton] at hx ⊢; rcases hx with hx | hx <;> simp_all)\n        · exact List.Subset.trans ihf (by intro x hx; simp only [List.mem_append, List.mem_singleton] at hx ⊢; rcases hx with hx | hx <;> simp_all)\n    | eq m e1 e2 ih1 ih2 =>\n        simp only [substOld, Lambda.LExpr.LExpr.getVars]\n        refine List.Subset.app ?_ ?_\n        · exact List.Subset.trans ih1 (by intro x hx; simp only [List.mem_append, List.mem_singleton] at hx ⊢; rcases hx with hx | hx <;> simp_all)\n        · exact List.Subset.trans ih2 (by intro x hx; simp only [List.mem_append, List.mem_singleton] at hx ⊢; rcases hx with hx | hx <;> simp_all)\n  simpa using gen post\n",
