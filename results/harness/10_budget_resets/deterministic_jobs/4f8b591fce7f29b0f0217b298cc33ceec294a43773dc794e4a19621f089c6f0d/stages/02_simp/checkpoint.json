  "proof": "lemma Typing.progress (der : Typing [] t τ) : t.Value ∨ ∃ t', t ⭢βᵛ t' := by\n  generalize eq : [] = Γ at der\n  have lc := der.wf.2.1\n  induction der <;> subst eq\n  case var => contradiction\n  case sub ih => exact ih rfl lc\n  case' app l r ih_l ih_r =>\n    cases ih_l rfl l.wf.2.1\n    case' inl => have := ih_r rfl r.wf.2.1\n  case' tapp der _ ih | let' der _ ih _ | inl der _ ih | inr der _ ih |\n      case der _ _ ih _ _ =>\n    cases ih rfl der.wf.2.1\n  case' case.inl val =>\n    obtain ⟨s, rfl | rfl⟩ := der.canonical_form_sum val <;> cases val\n  all_goals first\n  | left\n    constructor\n    assumption\n  | right\n    try simp only [body_let, body_case] at lc\n    cases lc\n    aesop (config := { enableSimp := false })\n      (add norm forward [canonical_form_abs, canonical_form_tabs],\n        100% Red)",
