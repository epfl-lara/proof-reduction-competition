  "proof": "theorem fold_advances_evaluation_poly\n  (i : Fin (ℓ)) (h_i_succ_lt : i + 1 < ℓ + 𝓡)\n  (coeffs : Fin (2 ^ (ℓ - ↑i)) → L) (r_chal : L) :\n  let P_i : L[X] := intermediateEvaluationPoly 𝔽q β h_ℓ_add_R_rate (i := ⟨i, by\n    exact Nat.lt_trans (n := i) (k := ℓ+1) (m := ℓ) (h₁ := i.isLt) (by exact Nat.lt_add_one ℓ)\n  ⟩) coeffs\n  let f_i := fun (x : (sDomain 𝔽q β h_ℓ_add_R_rate)\n      ⟨i, by exact Nat.lt_trans (n := i) (k := r) (m := ℓ) (h₁ := by omega) (by omega)⟩) =>\n    P_i.eval (x.val : L)\n  let f_i_plus_1 := fold (i := ⟨i, by omega⟩) (h_i := by omega) (f := f_i) (r_chal := r_chal)\n  let new_coeffs := fun j : Fin (2^(ℓ - (i + 1))) =>\n    (1 - r_chal) * (coeffs ⟨j.val * 2, by\n      rw [←Nat.add_zero (j.val * 2)]\n      apply mul_two_add_bit_lt_two_pow (c := ℓ - i) (a := j) (b := ℓ - (↑i + 1))\n        (i := 0) (by omega) (by omega)\n    ⟩) +\n    r_chal * (coeffs ⟨j.val * 2 + 1, by\n      apply mul_two_add_bit_lt_two_pow (c := ℓ - i) (a := j) (b := ℓ - (↑i + 1))\n        (i := 1) (by omega) (by omega)\n    ⟩)\n  let P_i_plus_1 :=\n    intermediateEvaluationPoly 𝔽q β h_ℓ_add_R_rate (i := ⟨i+1, by omega⟩) new_coeffs\n  ∀ (y : (sDomain 𝔽q β h_ℓ_add_R_rate)\n    ⟨i+1, by omega⟩), f_i_plus_1 y = P_i_plus_1.eval y.val := by\n  dsimp only\n  intro y\n  have hq := fun k : Fin 2 =>\n    (generates_quotient_point_if_is_fiber_of_y 𝔽q β i 1 i.isLt _ y ⟨k, rfl⟩).symm\n  simp only [iteratedQuotientMap_k_eq_1_is_qMap 𝔽q β h_ℓ_add_R_rate,\n    Subtype.eq_iff] at hq\n  trans (1 - r_chal) * (evenRefinement 𝔽q β h_ℓ_add_R_rate i coeffs).eval y.val +\n    r_chal * (oddRefinement 𝔽q β h_ℓ_add_R_rate i coeffs).eval y.val\n  · simp only [fold, evaluation_poly_split_identity 𝔽q β h_ℓ_add_R_rate i coeffs,\n      Polynomial.eval_add, eval_comp, Polynomial.eval_mul, Polynomial.eval_X, hq]\n    simp only [qMap_total_fiber_one_level_eq 𝔽q β i i.isLt y,\n      Fin2ToF2, one_ne_zero, ↓reduceIte, zero_smul, one_smul,\n      zero_add, Submodule.coe_add, get_sDomain_first_basis_eq_1]\n    ring\n  · simp only [evenRefinement, oddRefinement, intermediateEvaluationPoly,\n      Polynomial.eval_finset_sum, Polynomial.eval_C_mul, mul_sum,\n      ←sum_add_distrib, add_mul, mul_assoc]\n    rfl",
