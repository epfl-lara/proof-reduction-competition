  "proof": "theorem parallelReduction_diamond : Diamond ParallelReduction := by\n  intro a a₁ a₂ h₁ h₂\n  induction h₁ generalizing a₂\n  case refl => exact ⟨_, h₂, .refl _⟩\n  all_goals cases h₂\n  case par.par iha ihb a'' b'' ha'' hb'' =>\n    obtain ⟨a₃, ha₁, ha₂⟩ := iha ha''\n    obtain ⟨b₃, hb₁, hb₂⟩ := ihb hb''\n    exact ⟨_, .par ha₁ hb₁, .par ha₂ hb₂⟩\n  case' red_I.par | red_K.par | red_S.par => apply symm\n  case par.red_I | red_I.par =>\n    cases I_irreducible _ ‹_›\n    exact ⟨_, .red_I _, ‹_›⟩\n  case par.red_K | red_K.par =>\n    obtain ⟨x, h, rfl⟩ := Ka_irreducible _ _ ‹_›\n    exact ⟨_, .red_K .., h⟩\n  case par.red_S | red_S.par =>\n    obtain ⟨x, y, hx, hy, rfl⟩ := Sab_irreducible _ _ _ ‹_›\n    refine ⟨_, .red_S .., ?_⟩\n    apply ParallelReduction.par <;> apply ParallelReduction.par <;> assumption\n  all_goals\n    refine ⟨_, .refl _, ?_⟩\n    constructor <;> assumption",
