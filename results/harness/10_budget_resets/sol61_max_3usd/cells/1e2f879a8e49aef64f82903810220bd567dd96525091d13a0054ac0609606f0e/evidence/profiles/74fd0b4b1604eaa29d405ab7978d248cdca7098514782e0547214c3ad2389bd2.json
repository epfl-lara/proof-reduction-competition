  "code": "theorem bisimilarity_congr_choice :\n    (p ~[lts (defs := defs)] q) → (choice p r) ~[lts (defs := defs)] (choice q r) := by\n  intro h\n  exists _, ChoiceBisim.choice h\n  rintro _ _ (h | h) μ\n  all_goals constructor <;> intro s' ht\n  case' choice.left | choice.right =>\n    cases ht\n    case choiceR ht => use s', ht.choiceR, ChoiceBisim.bisim (HomBisimilarity.refl _)\n  all_goals\n    apply Exists.imp (fun _ => And.imp (by first | exact Tr.choiceL | exact id)\n      ChoiceBisim.bisim)\n    first | apply h.follow_fst | apply h.follow_snd\n    assumption\n",
