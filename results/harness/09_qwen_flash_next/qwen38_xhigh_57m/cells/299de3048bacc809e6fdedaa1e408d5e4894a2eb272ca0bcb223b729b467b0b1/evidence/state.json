  "best_proof": "lemma fundamental_theorem_of_variational_calculus' {f : Y → V}\n    (μ : Measure Y) [IsFiniteMeasureOnCompacts μ] [μ.IsOpenPosMeasure]\n    [OpensMeasurableSpace Y]\n    (hf : Continuous f) (hg : ∀ g, IsTestFunction g → ∫ x, ⟪f x, g x⟫_ℝ ∂μ = 0) :\n    f = 0 := by\n  funext x₀\n  by_contra hx0\n  let w : Y → ℝ := fun x => ⟪f x, f x₀⟫_ℝ\n  have hu : Continuous w := by fun_prop\n  have h₀ : 0 < w x₀ :=\n    lt_of_le_of_ne' real_inner_self_nonneg' (inner_self_eq_zero'.not.mpr hx0)\n  obtain ⟨δ, hδ0, hδ⟩ :=\n    Metric.eventually_nhds_iff.mp (continuousAt_const.eventually_lt hu.continuousAt h₀)\n  let B : ContDiffBump x₀ := ⟨δ / 2, δ, half_pos hδ0, half_lt_self hδ0⟩\n  have key := hg _ (IsTestFunction.smul_right ⟨B.contDiff, B.hasCompactSupport⟩ (contDiff_const (c := f x₀)))\n  simp only [inner_smul_right'] at key\n  have hn : ∀ x, 0 ≤ B x * w x := fun x => by\n    rcases lt_or_ge (dist x x₀) δ with h | h\n    · exact mul_nonneg B.nonneg (hδ h).le\n    · rw [B.zero_of_le_dist h, zero_mul]\n  exact ((B.continuous.mul hu).integral_pos_of_hasCompactSupport_nonneg_nonzero (x := x₀)\n    B.hasCompactSupport.mul_right hn (mul_pos (B.pos_of_mem_ball (Metric.mem_ball_self hδ0)) h₀).ne').ne' key\n",
