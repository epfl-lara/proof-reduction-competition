  "first_valid_proof": "open OldExpressions in\ntheorem extractedOldExprInVars :\n  NormalizedOldExpr post →\n  (extractOldExprVars post).Subset\n  (Imperative.HasVarsPure.getVars post) := by\n  intro Hnorm\n  have hap : ∀ {x y u v : List Expression.Ident},\n      x.Subset u → y.Subset v → (x ++ y).Subset (u ++ v) :=\n    fun hx hy => List.append_subset.2\n      ⟨List.subset_append_of_subset_left _ hx, List.subset_append_of_subset_right _ hy⟩\n  induction Hnorm with\n  | const | op | bvar | fvar => exact List.nil_subset _\n  | abs _ ih => exact ih\n  | quant _ _ ih₁ ih₂ => exact hap ih₁ ih₂\n  | eq _ _ ih₁ ih₂ => exact hap ih₁ ih₂\n  | ite _ _ _ ih₁ ih₂ ih₃ => exact hap (hap ih₁ ih₂) ih₃\n  | app _ _ hcond ihf ihe =>\n      unfold extractOldExprVars\n      split\n      · exact fun _ h => h\n      · next H => exact absurd (hcond IsOldPred.oldPred) fun g => by cases g; exact H _ _ _ rfl\n      · exact hap ihf ihe\n",
